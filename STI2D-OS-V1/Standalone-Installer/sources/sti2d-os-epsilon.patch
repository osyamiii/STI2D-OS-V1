diff --git a/epsilon/apps/sti2d/animation.cpp b/epsilon/apps/sti2d/animation.cpp
new file mode 100644
index 0000000..a914d76
--- /dev/null
+++ b/epsilon/apps/sti2d/animation.cpp
@@ -0,0 +1,135 @@
+#include "animation.h"
+
+#include <ion.h>
+#include <kandinsky/color.h>
+#if !PLATFORM_DEVICE
+#include <stdio.h>
+#include <stdlib.h>
+#endif
+
+#include "canvas.h"
+#include "theme.h"
+
+namespace STI2D {
+
+static int s_numberOfAnimations = 0;
+
+void startAnimation() { s_numberOfAnimations++; }
+
+static const char* freezeSetting() {
+#if PLATFORM_DEVICE
+  return nullptr;
+#else
+  const char* skip = getenv("STI2D_FREEZE_SKIP");
+  if (skip != nullptr && s_numberOfAnimations <= atoi(skip)) {
+    return nullptr;
+  }
+  return getenv("STI2D_FREEZE_MS");
+#endif
+}
+
+bool animationsFrozen() { return freezeSetting() != nullptr; }
+
+void holdFrozenFrame() {
+#if !PLATFORM_DEVICE
+  /* Save the frozen frame as a PPM image in STI2D_HOLD, then quit: this is
+   * how the screenshots of the animations are made. */
+  const char* path = getenv("STI2D_HOLD");
+  if (animationsFrozen() && path != nullptr) {
+    static KDColor pixels[Ion::Display::Width * Ion::Display::Height];
+    Ion::Display::pullRect(Ion::Display::Rect, pixels);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+      fprintf(f, "P6\n%d %d\n255\n", Ion::Display::Width,
+              Ion::Display::Height);
+      for (int i = 0; i < Ion::Display::Width * Ion::Display::Height; i++) {
+        uint16_t c = pixels[i];
+        uint8_t rgb[3] = {(uint8_t)((c >> 11) << 3 | (c >> 13)),
+                          (uint8_t)(((c >> 5) & 0x3F) << 2 | ((c >> 9) & 3)),
+                          (uint8_t)((c & 0x1F) << 3 | ((c >> 2) & 7))};
+        fwrite(rgb, 1, 3, f);
+      }
+      fclose(f);
+    }
+    exit(0);
+  }
+#endif
+}
+
+float frameTime(uint64_t startMillis) {
+#if !PLATFORM_DEVICE
+  const char* freeze = freezeSetting();
+  if (freeze != nullptr) {
+    return (float)atoi(freeze);
+  }
+#endif
+  return (float)(Ion::Timing::millis() - startMillis);
+}
+
+static void drawBootFrame(float t) {
+  constexpr float cx = Ion::Display::Width / 2.0f;
+  constexpr float cy = 96.0f;
+  constexpr float thickness = 14.0f;
+  constexpr float radii[3] = {58.0f, 42.0f, 26.0f};
+  // Exit: the logo zooms toward the viewer while fading out
+  float exit = easeInOutCubic((t - 2100.0f) / 420.0f);
+  float zoom = 1.0f + 1.6f * exit;
+  int global = (int)((1.0f - exit) * 256.0f);
+  float trackAlpha = clamp01(t / 300.0f) * 0.2f;
+  float titleIn = easeOutCubic((t - 900.0f) / 500.0f);
+  float subtitleIn = easeOutCubic((t - 1250.0f) / 450.0f);
+  float glowIn = easeOutCubic((t - 700.0f) / 700.0f);
+
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(KDRect(0, 0, Ion::Display::Width, Ion::Display::Height),
+                KDPointZero, buffer);
+  while (canvas.nextBand()) {
+    canvas.clear(KDBlack);
+    // A soft halo lights the rings up once they are closed
+    canvas.glow(cx, cy, radii[0] * zoom, 30.0f * zoom, k_ringColors[0],
+                (int)(glowIn * 50 * global) >> 8);
+    for (int i = 0; i < 3; i++) {
+      float r = radii[i] * zoom;
+      float th = thickness * zoom;
+      canvas.arc(cx, cy, r, th, 0.0f, 1.0f, k_ringColors[i],
+                 (int)(trackAlpha * global));
+      float sweep =
+          0.999f * easeOutCubic((t - 150.0f - 140.0f * i) / 950.0f);
+      canvas.arc(cx, cy, r, th, 0.0f, sweep, k_ringColors[i], global);
+    }
+    if (titleIn > 0.0f) {
+      float scale = 1.0f + 0.25f * (1.0f - titleIn) + 0.6f * exit;
+      canvas.centeredText("STI2D OS", k_titleFont, cx,
+                          170.0f + 12.0f * (1.0f - titleIn) + 30.0f * exit -
+                              (scale - 1.0f) * 15.0f,
+                          KDWhite, (int)(titleIn * global), scale);
+    }
+    if (subtitleIn > 0.0f) {
+      canvas.centeredText("Yamii  ×  Derim", k_smallFont, cx,
+                          210.0f + 30.0f * exit, k_secondaryText,
+                          (int)(subtitleIn * global));
+    }
+  }
+}
+
+void playBootAnimation() {
+  constexpr float duration = 2550.0f;
+  startAnimation();
+  uint64_t start = Ion::Timing::millis();
+  while (true) {
+    float t = frameTime(start);
+    Ion::Display::waitForVBlank();
+    drawBootFrame(t);
+    if (animationsFrozen()) {
+      holdFrozenFrame();
+      return;
+    }
+    // Any key skips the animation
+    if (t >= duration || (t > 250.0f && Ion::Keyboard::scan() != 0)) {
+      break;
+    }
+  }
+  Ion::Display::pushRectUniform(Ion::Display::Rect, KDBlack);
+}
+
+}  // namespace STI2D
