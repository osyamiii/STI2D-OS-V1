new file mode 100644
index 0000000..16df7a7
--- /dev/null
+++ b/tools/sti2d/make_sms.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Compile the conversations of the SMS app (sms_library.py) into
+apps/sms/library.cpp. The texts are packed in LZ4 blocks: the whole library
+takes a few kilobytes of flash, and nothing of the calculator's storage.
+
+Usage: make_sms.py <apps/sms/library.cpp>"""
+import os
+import sys
+import unicodedata
+
+import lz4.block
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import sms_library as lib  # noqa: E402
+
+BLOCK = 4096
+OUT = sys.argv[1]
+
+def normalize(text):
+    text = unicodedata.normalize("NFKD", text.lower())
+    return "".join(c for c in text if not unicodedata.combining(c))
+
+strings, ids = [], {}
+def sid(text):
+    text = unicodedata.normalize("NFC", text)
+    if text not in ids:
+        ids[text] = len(strings)
+        strings.append(text)
+    return ids[text]
+
+topics = [t for t, _ in lib.TOPICS] + ["calcul", "name"]
+topic_index = {t: i for i, t in enumerate(topics)}
+
+id_list = []
+def add_range(texts):
+    start = len(id_list)
+    for t in texts:
+        id_list.append(sid(t))
+    return (start, len(texts))
+
+shared = [add_range(lib.SHARED.get(t, [])) for t in topics]
+fallback = add_range(lib.FALLBACK)
+quick = add_range(lib.QUICK)
+characters = []
+for c in lib.CHARACTERS:
+    characters.append({
+        "name": c["name"], "tagline": c["tagline"], "color": c["color"], "nickname": c["nickname"],
+        "prefixes": add_range(c["prefixes"]), "suffixes": add_range(c["suffixes"]),
+        "greetings": add_range(c["greetings"]),
+        "topics": [add_range(c["replies"].get(t, [])) for t in topics],
+    })
+
+# Pack the strings, NUL-terminated, in blocks that strings never straddle
+blocks, offsets, current = [], [], bytearray()
+for text in strings:
+    data = text.encode("utf-8") + b"\0"
+    if len(current) + len(data) > BLOCK:
+        blocks.append(bytes(current))
+        current = bytearray()
+    offsets.append((len(blocks), len(current)))
+    current += data
+blocks.append(bytes(current))
+assert len(blocks) <= 16, "Too many blocks for 16-bit string references"
+compressed = [lz4.block.compress(b, mode="high_compression", compression=12, store_size=False) for b in blocks]
+
+def c_string(text):
+    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'
+
+out = ["// Generated by tools/sti2d/make_sms.py from tools/sti2d/sms_library.py, do not edit",
+       '#include "library.h"', "", "namespace Sms {", "namespace Library {", ""]
+out.append(f"const int k_numberOfTopics = {len(topics)};")
+out.append(f"const int k_calculTopic = {topic_index['calcul']};")
+out.append(f"const int k_nameTopic = {topic_index['name']};")
+out.append(f"const int k_timeTopic = {topic_index['heure']};")
+out.append("const char* const k_topicKeywords[] = {")
+for t, keywords in lib.TOPICS:
+    words = keywords.split("|") if "|" in keywords else keywords.split(" ")
+    # With |, keywords are phrases: a long first one means formats were mixed
+    assert "|" not in keywords or len(words[0].split(" ")) <= 3, f"Mixed keyword formats in {t}"
+    out.append("  " + c_string("|".join(normalize(w) for w in words)) + ",")
+out.append("};")
+out.append(f"const int k_numberOfBlocks = {len(blocks)};")
+for i, data in enumerate(compressed):
+    out.append(f"static const uint8_t s_block{i}[] = {{" + ",".join(str(b) for b in data) + "};")
+out.append("const Block k_blocks[] = {" + ", ".join(f"{{s_block{i}, {len(d)}, {len(blocks[i])}}}" for i, d in enumerate(compressed)) + "};")
+out.append("const uint16_t k_strings[] = {" + ",".join(str((b << 12) | o) for b, o in offsets) + "};")
+out.append("const uint16_t k_ids[] = {" + ",".join(str(i) for i in id_list) + "};")
+def rng(r):
+    return f"{{{r[0]}, {r[1]}}}"
+out.append("const Range k_shared[] = {" + ", ".join(rng(r) for r in shared) + "};")
+out.append(f"const Range k_fallback = {rng(fallback)};")
+out.append(f"const Range k_quickReplies = {rng(quick)};")
+out.append(f"const int k_numberOfCharacters = {len(characters)};")
+out.append("const Character k_characters[] = {")
+for c in characters:
+    out.append(f"  {{{c_string(c['name'])}, {c_string(c['tagline'])}, {c_string(c['nickname'])}, 0x{c['color']:06X}, "
+               f"{rng(c['prefixes'])}, {rng(c['suffixes'])}, {rng(c['greetings'])},")
+    out.append("   {" + ", ".join(rng(r) for r in c["topics"]) + "}},")
+out.append("};")
+out.append("")
+out.append("}  // namespace Library")
+out.append("}  // namespace Sms")
+open(OUT, "w").write("\n".join(out) + "\n")
+
+header = f"""// Generated by tools/sti2d/make_sms.py, do not edit
+#pragma once
+
+#include <stdint.h>
+
+namespace Sms {{
+namespace Library {{
+
+constexpr int k_topicCount = {len(topics)};
+
+struct Block {{
+  const uint8_t* data;  // LZ4
+  uint16_t compressedSize;
+  uint16_t size;
+}};
+struct Range {{
+  uint16_t start;  // In k_ids
+  uint8_t count;
+}};
+struct Character {{
+  const char* name;
+  const char* tagline;
+  const char* nickname;
+  uint32_t color;
+  Range prefixes;
+  Range suffixes;
+  Range greetings;
+  Range topics[k_topicCount];
+}};
+
+extern const int k_numberOfTopics;
+extern const int k_calculTopic;
+extern const int k_nameTopic;
+extern const int k_timeTopic;
+// For each topic, its keywords separated by |
+extern const char* const k_topicKeywords[];
+extern const int k_numberOfBlocks;
+extern const Block k_blocks[];
+// Where each text is: block << 12 | offset in the block
+extern const uint16_t k_strings[];
+// Lists of texts, referenced by ranges
+extern const uint16_t k_ids[];
+extern const Range k_shared[];
+extern const Range k_fallback;
+extern const Range k_quickReplies;
+extern const int k_numberOfCharacters;
+extern const Character k_characters[];
+
+}}  // namespace Library
+}}  // namespace Sms
+"""
+open(os.path.join(os.path.dirname(OUT), "library.h"), "w").write(header)
+
+raw = sum(len(b) for b in blocks)
+packed = sum(len(c) for c in compressed)
+print(f"{len(strings)} texts, {raw} B of text packed in {packed} B ({len(blocks)} blocks), {len(topics)} topics")
