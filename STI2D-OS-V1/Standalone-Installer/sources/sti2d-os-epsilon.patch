diff --git a/epsilon/apps/sti2d/canvas.cpp b/epsilon/apps/sti2d/canvas.cpp
new file mode 100644
index 0000000..2022e20
--- /dev/null
+++ b/epsilon/apps/sti2d/canvas.cpp
@@ -0,0 +1,565 @@
+#include "canvas.h"
+
+#include <assert.h>
+#include <omg/utf8_decoder.h>
+
+#include <cmath>
+
+namespace STI2D {
+
+static inline int clampInt(int v, int lo, int hi) {
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+static inline int floorInt(float v) {
+  int i = (int)v;
+  return (v < i) ? i - 1 : i;
+}
+static inline int ceilInt(float v) {
+  int i = (int)v;
+  return (v > i) ? i + 1 : i;
+}
+// Pixel coverage (in [0, 256]) of an edge at signed distance d (positive inside)
+static inline int coverage(float d) {
+  return clampInt((int)((d + 0.5f) * 256.0f), 0, 256);
+}
+
+float clamp01(float t) { return t < 0.0f ? 0.0f : (t > 1.0f ? 1.0f : t); }
+float easeOutCubic(float t) {
+  t = clamp01(t);
+  float u = 1.0f - t;
+  return 1.0f - u * u * u;
+}
+float easeInOutCubic(float t) {
+  t = clamp01(t);
+  float u = -2.0f * t + 2.0f;
+  return t < 0.5f ? 4.0f * t * t * t : 1.0f - u * u * u / 2.0f;
+}
+float easeOutBack(float t) {
+  t = clamp01(t);
+  constexpr float c1 = 1.70158f;
+  constexpr float c3 = c1 + 1.0f;
+  float u = t - 1.0f;
+  return 1.0f + c3 * u * u * u + c1 * u * u;
+}
+
+const Font::Glyph* Font::glyph(uint32_t codePoint) const {
+  int lo = 0, hi = numberOfGlyphs - 1;
+  while (lo <= hi) {
+    int mid = (lo + hi) / 2;
+    if (glyphs[mid].codePoint == codePoint) {
+      return &glyphs[mid];
+    }
+    if (glyphs[mid].codePoint < codePoint) {
+      lo = mid + 1;
+    } else {
+      hi = mid - 1;
+    }
+  }
+  return nullptr;
+}
+
+static uint32_t compose(uint32_t base, uint32_t mark) {
+  for (int i = 0; i < k_numberOfCompositions; i++) {
+    if (k_compositions[i].base == base && k_compositions[i].mark == mark) {
+      return k_compositions[i].result;
+    }
+  }
+  return 0;
+}
+
+/* Decode an NFKD UTF-8 string into precomposed code points, so that accented
+ * letters use their own glyph. */
+class ComposingDecoder {
+ public:
+  ComposingDecoder(const char* text) : m_decoder(text), m_next(0) {
+    m_next = m_decoder.nextCodePoint();
+  }
+  uint32_t next() {
+    uint32_t c = m_next;
+    if (c == 0) {
+      return 0;
+    }
+    m_next = m_decoder.nextCodePoint();
+    while (m_next != 0 && CodePoint(m_next).isCombining()) {
+      uint32_t composed = compose(c, m_next);
+      if (composed != 0) {
+        c = composed;
+      }
+      m_next = m_decoder.nextCodePoint();
+    }
+    return c;
+  }
+
+ private:
+  UTF8Decoder m_decoder;
+  uint32_t m_next;
+};
+
+KDColor Canvas::mix(KDColor background, KDColor foreground, int alpha) {
+  uint16_t b = background;
+  uint16_t f = foreground;
+  int r = (b >> 11) + ((((f >> 11) - (b >> 11)) * alpha) >> 8);
+  int g = ((b >> 5) & 0x3F) +
+          (((((f >> 5) & 0x3F) - ((b >> 5) & 0x3F)) * alpha) >> 8);
+  int bl = (b & 0x1F) + ((((f & 0x1F) - (b & 0x1F)) * alpha) >> 8);
+  return KDColor::RGB16((r << 11) | (g << 5) | bl);
+}
+
+extern "C" int LZ4_decompress_safe_partial(const char* src, char* dst,
+                                           int srcSize, int targetOutputSize,
+                                           int dstCapacity);
+
+static void decompressRows(const uint8_t* compressedPixels, int compressedSize,
+                           KDColor* buffer, int numberOfRows) {
+  LZ4_decompress_safe_partial(
+      reinterpret_cast<const char*>(compressedPixels),
+      reinterpret_cast<char*>(buffer), compressedSize,
+      numberOfRows * Canvas::k_iconWidth * sizeof(KDColor),
+      Canvas::k_iconPixelCount * sizeof(KDColor));
+}
+
+KDColor Canvas::IconTint(const uint8_t* compressedPixels, int compressedSize) {
+  // The bubble color, sampled on the left side of the disc, away from the glyph
+  constexpr int row = 28;
+  KDColor rows[(row + 1) * k_iconWidth];
+  LZ4_decompress_safe_partial(reinterpret_cast<const char*>(compressedPixels),
+                              reinterpret_cast<char*>(rows), compressedSize,
+                              sizeof(rows), sizeof(rows));
+  return rows[row * k_iconWidth + 4];
+}
+
+const KDColor* Canvas::iconRows(const uint8_t* compressedPixels,
+                                int compressedSize, int numberOfRows) {
+  if (m_iconInBuffer != compressedPixels ||
+      m_iconRowsInBuffer < numberOfRows) {
+    decompressRows(compressedPixels, compressedSize, m_iconBuffer,
+                   numberOfRows);
+    m_iconInBuffer = compressedPixels;
+    m_iconRowsInBuffer = numberOfRows;
+  }
+  return m_iconBuffer;
+}
+
+Canvas::Canvas(KDRect area, KDPoint origin, KDColor* buffer)
+    : m_iconInBuffer(nullptr),
+      m_iconRowsInBuffer(0),
+      m_area(area),
+      m_origin(origin),
+      m_buffer(buffer),
+      m_bandTop(area.top()),
+      m_bandBottom(area.top()) {
+  assert(area.width() <= Ion::Display::Width);
+}
+
+void Canvas::flush() {
+  if (m_bandBottom > m_bandTop) {
+    KDRect r(m_area.left() + m_origin.x(), m_bandTop + m_origin.y(),
+             m_area.width(), m_bandBottom - m_bandTop);
+    Ion::Display::pushRect(r, m_buffer);
+  }
+}
+
+bool Canvas::nextBand() {
+  flush();
+  m_bandTop = m_bandBottom;
+  if (m_bandTop >= m_area.bottom()) {
+    return false;
+  }
+  m_bandBottom = m_bandTop + k_bandHeight;
+  if (m_bandBottom > m_area.bottom()) {
+    m_bandBottom = m_area.bottom();
+  }
+  return true;
+}
+
+void Canvas::clear(KDColor color) {
+  int n = m_area.width() * (m_bandBottom - m_bandTop);
+  for (int i = 0; i < n; i++) {
+    m_buffer[i] = color;
+  }
+}
+
+void Canvas::verticalGradient(int y0, int y1, KDColor top, KDColor bottom) {
+  int from = y0 < m_bandTop ? m_bandTop : y0;
+  int to = y1 > m_bandBottom ? m_bandBottom : y1;
+  for (int j = from; j < to; j++) {
+    KDColor c = mix(top, bottom, (j - y0) * 256 / (y1 - y0));
+    blendSpan(j, m_area.left(), m_area.right(), c, 256);
+  }
+}
+
+void Canvas::blendSpan(int y, int x0, int x1, KDColor color, int alpha) {
+  x0 = x0 < m_area.left() ? m_area.left() : x0;
+  x1 = x1 > m_area.right() ? m_area.right() : x1;
+  if (alpha <= 0) {
+    return;
+  }
+  KDColor* p = m_buffer + (y - m_bandTop) * m_area.width() + (x0 - m_area.left());
+  for (int x = x0; x < x1; x++, p++) {
+    *p = alpha >= 256 ? color : mix(*p, color, alpha);
+  }
+}
+
+void Canvas::fillRect(int x, int y, int width, int height, KDColor color,
+                      int alpha) {
+  int y0 = y < m_bandTop ? m_bandTop : y;
+  int y1 = y + height > m_bandBottom ? m_bandBottom : y + height;
+  for (int j = y0; j < y1; j++) {
+    blendSpan(j, x, x + width, color, alpha);
+  }
+}
+
+void Canvas::fillRoundedRect(float x, float y, float width, float height,
+                             float radius, KDColor color, int alpha) {
+  if (!intersects(y - 1, y + height + 1)) {
+    return;
+  }
+  int y0 = clampInt(floorInt(y), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(y + height), m_bandTop, m_bandBottom);
+  for (int j = y0; j < y1; j++) {
+    float py = j + 0.5f;
+    // Vertical coverage of the row
+    int rowCoverage = coverage(minFloat(py - y, y + height - py));
+    // Distance to the rounded corners' centers
+    float cy = py < y + radius ? y + radius
+                               : (py > y + height - radius ? y + height - radius
+                                                           : py);
+    float dy = py - cy;
+    float inset = radius - std::sqrt(maxFloat(radius * radius - dy * dy, 0.0f));
+    for (int i = floorInt(x); i < ceilInt(x + width); i++) {
+      float px = i + 0.5f;
+      float d = minFloat(px - (x + inset), (x + width - inset) - px);
+      if (dy != 0.0f && (px < x + radius || px > x + width - radius)) {
+        float cx = px < x + radius ? x + radius : x + width - radius;
+        float dx = px - cx;
+        d = radius - std::sqrt(dx * dx + dy * dy);
+      }
+      int c = coverage(d);
+      c = c < rowCoverage ? c : rowCoverage;
+      blendPixel(i, j, color, c * alpha >> 8);
+    }
+  }
+}
+
+void Canvas::darkenRows(int y0, int y1, int alphaAtY0, int alphaAtY1) {
+  int from = y0 < m_bandTop ? m_bandTop : y0;
+  int to = y1 > m_bandBottom ? m_bandBottom : y1;
+  for (int j = from; j < to; j++) {
+    int a = alphaAtY0 + (alphaAtY1 - alphaAtY0) * (j - y0) / (y1 - y0);
+    blendSpan(j, m_area.left(), m_area.right(), KDBlack, a);
+  }
+}
+
+void Canvas::fillCircle(float cx, float cy, float r, KDColor color,
+                        int alpha) {
+  if (r <= 0.0f || !intersects(cy - r - 1, cy + r + 1)) {
+    return;
+  }
+  int y0 = clampInt(floorInt(cy - r - 1), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(cy + r + 1), m_bandTop, m_bandBottom);
+  for (int y = y0; y < y1; y++) {
+    float dy = y + 0.5f - cy;
+    float h2 = (r + 0.5f) * (r + 0.5f) - dy * dy;
+    if (h2 <= 0.0f) {
+      continue;
+    }
+    float h = std::sqrt(h2);
+    // Solid interior span, where the whole pixel is inside the disc
+    float inner2 = (r - 0.75f) * (r - 0.75f) - dy * dy;
+    float hi = inner2 > 0.0f ? std::sqrt(inner2) : 0.0f;
+    int solid0 = ceilInt(cx - hi);
+    int solid1 = floorInt(cx + hi);
+    if (hi > 0.0f && solid1 > solid0) {
+      blendSpan(y, solid0, solid1, color, alpha);
+    } else {
+      solid0 = solid1 = floorInt(cx);
+    }
+    int e0 = floorInt(cx - h);
+    int e1 = ceilInt(cx + h);
+    for (int x = e0; x < e1; x++) {
+      if (x >= solid0 && x < solid1) {
+        x = solid1 - 1;
+        continue;
+      }
+      float dx = x + 0.5f - cx;
+      float d = r - std::sqrt(dx * dx + dy * dy);
+      blendPixel(x, y, color, coverage(d) * alpha >> 8);
+    }
+  }
+}
+
+void Canvas::glow(float cx, float cy, float r, float spread, KDColor color,
+                  int alpha) {
+  float outer = r + spread;
+  if (alpha <= 0 || !intersects(cy - outer, cy + outer)) {
+    return;
+  }
+  int y0 = clampInt(floorInt(cy - outer), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(cy + outer), m_bandTop, m_bandBottom);
+  for (int y = y0; y < y1; y++) {
+    float dy = y + 0.5f - cy;
+    float h2 = outer * outer - dy * dy;
+    if (h2 <= 0.0f) {
+      continue;
+    }
+    float h = std::sqrt(h2);
+    for (int x = floorInt(cx - h); x < ceilInt(cx + h); x++) {
+      float dx = x + 0.5f - cx;
+      float d = std::sqrt(dx * dx + dy * dy);
+      if (d < r - 1.0f) {
+        continue;
+      }
+      float t = 1.0f - clamp01((d - r) / spread);
+      blendPixel(x, y, color, (int)(t * t * alpha));
+    }
+  }
+}
+
+void Canvas::arc(float cx, float cy, float r, float thickness, float start,
+                 float sweep, KDColor color, int alpha) {
+  float outer = r + thickness / 2.0f;
+  float inner = r - thickness / 2.0f;
+  if (sweep <= 0.0f || alpha <= 0 ||
+      !intersects(cy - outer - 1, cy + outer + 1)) {
+    return;
+  }
+  constexpr float twoPi = 6.2831853f;
+  bool full = sweep >= 1.0f;
+  int y0 = clampInt(floorInt(cy - outer - 1), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(cy + outer + 1), m_bandTop, m_bandBottom);
+  for (int y = y0; y < y1; y++) {
+    float dy = y + 0.5f - cy;
+    float h2 = (outer + 0.5f) * (outer + 0.5f) - dy * dy;
+    if (h2 <= 0.0f) {
+      continue;
+    }
+    float h = std::sqrt(h2);
+    for (int x = floorInt(cx - h); x < ceilInt(cx + h); x++) {
+      float dx = x + 0.5f - cx;
+      float d = std::sqrt(dx * dx + dy * dy);
+      if (d < inner - 0.5f) {
+        // Skip the hole of the ring
+        float skip2 = (inner - 0.5f) * (inner - 0.5f) - dy * dy;
+        if (skip2 > 0.0f && dx < 0.0f) {
+          // Never go backwards, or the loop would never end
+          int skipTo = floorInt(cx + std::sqrt(skip2)) - 1;
+          x = skipTo > x ? skipTo : x;
+        }
+        continue;
+      }
+      int c = coverage(outer - d);
+      int ci = coverage(d - inner);
+      c = c < ci ? c : ci;
+      if (c == 0) {
+        continue;
+      }
+      if (!full) {
+        float a = std::atan2(dx, -dy) / twoPi;
+        a = a < 0.0f ? a + 1.0f : a;
+        a -= start;
+        a -= floorInt(a);
+        if (a > sweep) {
+          continue;
+        }
+      }
+      blendPixel(x, y, color, c * alpha >> 8);
+    }
+  }
+  if (!full) {
+    // Rounded caps
+    float a0 = start * twoPi;
+    float a1 = (start + sweep) * twoPi;
+    fillCircle(cx + r * std::sin(a0), cy - r * std::cos(a0), thickness / 2.0f,
+               color, alpha);
+    fillCircle(cx + r * std::sin(a1), cy - r * std::cos(a1), thickness / 2.0f,
+               color, alpha);
+  }
+}
+
+void Canvas::icon(const uint8_t* compressedPixels, int compressedSize,
+                  float cx, float cy, float scale, int alpha) {
+  constexpr float radius = 27.0f;
+  float R = radius * scale;
+  if (scale <= 0.02f || alpha <= 0 || !intersects(cy - R - 1, cy + R + 1)) {
+    return;
+  }
+  bool pixelPerfect = scale > 0.985f && scale < 1.015f;
+  if (pixelPerfect) {
+    // Snap to the pixel grid so that the icon stays perfectly sharp
+    scale = 1.0f;
+    R = radius;
+    cx = floorInt(cx - k_iconWidth / 2.0f + 0.5f) + k_iconWidth / 2.0f;
+    cy = floorInt(cy - k_iconHeight / 2.0f + 0.5f) + k_iconHeight / 2.0f;
+  }
+  float left = cx - k_iconWidth / 2.0f * scale;
+  float top = cy - k_iconHeight / 2.0f * scale;
+  float inv = 1.0f / scale;
+  int y0 = clampInt(floorInt(cy - R - 1), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(cy + R + 1), m_bandTop, m_bandBottom);
+  if (y0 >= y1) {
+    return;
+  }
+  // Decompress the icon up to the last row this band samples
+  int lastRow = clampInt(floorInt((y1 + 0.5f - top) * inv - 0.5f) + 2, 1,
+                         k_iconHeight);
+  const KDColor* pixels = iconRows(compressedPixels, compressedSize, lastRow);
+  for (int y = y0; y < y1; y++) {
+    float dy = y + 0.5f - cy;
+    float h2 = (R + 0.5f) * (R + 0.5f) - dy * dy;
+    if (h2 <= 0.0f) {
+      continue;
+    }
+    float h = std::sqrt(h2);
+    float v = (y + 0.5f - top) * inv - 0.5f;
+    int vi = floorInt(v);
+    int fv = (int)((v - vi) * 256.0f);
+    int v0 = clampInt(vi, 0, k_iconHeight - 1);
+    int v1 = clampInt(vi + 1, 0, k_iconHeight - 1);
+    const KDColor* row0 = pixels + v0 * k_iconWidth;
+    const KDColor* row1 = pixels + v1 * k_iconWidth;
+    int xStart = floorInt(cx - h);
+    int xEnd = ceilInt(cx + h);
+    xStart = xStart < m_area.left() ? m_area.left() : xStart;
+    xEnd = xEnd > m_area.right() ? m_area.right() : xEnd;
+    // Pixels well inside the disc need no anti-aliasing
+    float inner2 = (R - 0.75f) * (R - 0.75f) - dy * dy;
+    float hi = inner2 > 0.0f ? std::sqrt(inner2) : -1.0f;
+    float solid0 = cx - hi;
+    float solid1 = cx + hi - 1.0f;
+    for (int x = xStart; x < xEnd; x++) {
+      int c = 256;
+      if (x < solid0 || x > solid1) {
+        float dx = x + 0.5f - cx;
+        c = coverage(R - std::sqrt(dx * dx + dy * dy));
+      }
+      if (c == 0) {
+        continue;
+      }
+      KDColor color;
+      if (pixelPerfect) {
+        color = row0[clampInt(x - (int)left, 0, k_iconWidth - 1)];
+      } else {
+        float u = (x + 0.5f - left) * inv - 0.5f;
+        int ui = floorInt(u);
+        int fu = (int)((u - ui) * 256.0f);
+        int u0 = clampInt(ui, 0, k_iconWidth - 1);
+        int u1 = clampInt(ui + 1, 0, k_iconWidth - 1);
+        KDColor topColor = mix(row0[u0], row0[u1], fu);
+        KDColor bottomColor = mix(row1[u0], row1[u1], fu);
+        color = mix(topColor, bottomColor, fv);
+      }
+      blendPixel(x, y, color, c * alpha >> 8);
+    }
+  }
+}
+
+static inline int glyphAlpha(const uint8_t* data, int index) {
+  uint8_t byte = data[index / 2];
+  return (index % 2) ? (byte & 0xF) : (byte >> 4);
+}
+
+void Canvas::glyph(const Font& font, const Font::Glyph* g, float penX,
+                   float y, KDColor color, int alpha, float scale) {
+  if (g->width == 0) {
+    return;
+  }
+  float gx = penX + g->offsetX * scale;
+  float gy = y + g->offsetY * scale;
+  float gw = g->width * scale;
+  float gh = g->height * scale;
+  if (!intersects(gy, gy + gh) || gx >= m_area.right() ||
+      gx + gw <= m_area.left()) {
+    return;
+  }
+  const uint8_t* data = font.data + g->dataOffset;
+  int y0 = clampInt(floorInt(gy), m_bandTop, m_bandBottom);
+  int y1 = clampInt(ceilInt(gy + gh), m_bandTop, m_bandBottom);
+  if (scale == 1.0f) {
+    int left = (int)roundFloat(gx);
+    int top = (int)roundFloat(gy);
+    y0 = clampInt(top, m_bandTop, m_bandBottom);
+    y1 = clampInt(top + g->height, m_bandTop, m_bandBottom);
+    for (int j = y0; j < y1; j++) {
+      int row = (j - top) * g->width;
+      for (int i = 0; i < g->width; i++) {
+        int a = glyphAlpha(data, row + i);
+        if (a > 0) {
+          blendPixel(left + i, j, color, (a * 256 / 15) * alpha >> 8);
+        }
+      }
+    }
+    return;
+  }
+  float inv = 1.0f / scale;
+  for (int j = y0; j < y1; j++) {
+    float v = (j + 0.5f - gy) * inv - 0.5f;
+    int vi = floorInt(v);
+    float fv = v - vi;
+    for (int i = floorInt(gx); i < ceilInt(gx + gw); i++) {
+      float u = (i + 0.5f - gx) * inv - 0.5f;
+      int ui = floorInt(u);
+      float fu = u - ui;
+      int s[4];
+      for (int k = 0; k < 4; k++) {
+        int px = ui + (k & 1);
+        int py = vi + (k >> 1);
+        s[k] = (px < 0 || py < 0 || px >= g->width || py >= g->height)
+                   ? 0
+                   : glyphAlpha(data, py * g->width + px);
+      }
+      float a = ((s[0] * (1 - fu) + s[1] * fu) * (1 - fv) +
+                 (s[2] * (1 - fu) + s[3] * fu) * fv) /
+                15.0f;
+      if (a > 0.0f) {
+        blendPixel(i, j, color, (int)(a * 256.0f) * alpha >> 8);
+      }
+    }
+  }
+}
+
+float Canvas::textWidth(const char* text, const Font& font, float scale) {
+  float width = 0.0f;
+  ComposingDecoder decoder(text);
+  for (uint32_t c = decoder.next(); c != 0; c = decoder.next()) {
+    const Font::Glyph* g = font.glyph(c);
+    if (g == nullptr) {
+      g = font.glyph('?');
+    }
+    if (g) {
+      width += g->advance * scale;
+    }
+  }
+  return width;
+}
+
+void Canvas::text(const char* text, const Font& font, float x, float y,
+                  KDColor color, int alpha, float scale) {
+  if (alpha <= 0 || !intersects(y, y + font.lineHeight() * scale)) {
+    return;
+  }
+  float penX = x;
+  ComposingDecoder decoder(text);
+  for (uint32_t c = decoder.next(); c != 0; c = decoder.next()) {
+    const Font::Glyph* g = font.glyph(c);
+    if (g == nullptr) {
+      g = font.glyph('?');
+      if (g == nullptr) {
+        continue;
+      }
+    }
+    glyph(font, g, penX, y, color, alpha, scale);
+    penX += g->advance * scale;
+  }
+}
+
+void Canvas::centeredText(const char* text, const Font& font, float cx,
+                          float y, KDColor color, int alpha, float scale) {
+  float w = textWidth(text, font, scale);
+  float x = cx - w / 2.0f;
+  if (scale == 1.0f) {
+    x = roundFloat(x);
+  }
+  this->text(text, font, x, y, color, alpha, scale);
+}
+
+}  // namespace STI2D
diff --git a/epsilon/apps/sti2d/canvas.h b/epsilon/apps/sti2d/canvas.h
new file mode 100644
index 0000000..88e1a5b
--- /dev/null
+++ b/epsilon/apps/sti2d/canvas.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include <ion/display.h>
+#include <kandinsky/color.h>
+#include <kandinsky/point.h>
+#include <kandinsky/rect.h>
+
+#include "fonts.h"
+
+/* STI2D OS rendering engine.
+ *
+ * The calculator has no frame buffer we can afford: a full 320x240 frame would
+ * use 150 kB of RAM. Instead, a frame is composited band by band in a small
+ * buffer (a few lines of the screen), and each finished band is pushed to the
+ * display at once. Nothing is ever drawn twice on the screen, so animations
+ * are flicker-free, and every primitive is anti-aliased.
+ *
+ * Usage:
+ *   KDColor buffer[Canvas::k_bufferSize];
+ *   Canvas canvas(area, origin, buffer);
+ *   while (canvas.nextBand()) {
+ *     canvas.clear(KDColorBlack);
+ *     ... draw the whole scene, the canvas clips it to the current band ...
+ *   } */
+
+namespace STI2D {
+
+class Canvas {
+ public:
+  constexpr static int k_bandHeight = 8;
+  constexpr static int k_bufferSize = Ion::Display::Width * k_bandHeight;
+  constexpr static int k_iconWidth = 55;
+  constexpr static int k_iconHeight = 56;
+  constexpr static int k_iconPixelCount = k_iconWidth * k_iconHeight;
+
+  /* area is the part of the scene to render, in scene coordinates. origin is
+   * the position of the scene origin on the screen. */
+  Canvas(KDRect area, KDPoint origin, KDColor* buffer);
+  bool nextBand();
+  int top() const { return m_bandTop; }
+  int bottom() const { return m_bandBottom; }
+  bool intersects(float y0, float y1) const {
+    return y1 >= m_bandTop && y0 < m_bandBottom;
+  }
+
+  void clear(KDColor color);
+  void verticalGradient(int y0, int y1, KDColor top, KDColor bottom);
+  void fillRect(int x, int y, int width, int height, KDColor color,
+                int alpha = 256);
+  void fillRoundedRect(float x, float y, float width, float height,
+                       float radius, KDColor color, int alpha = 256);
+  void fillCircle(float cx, float cy, float r, KDColor color, int alpha = 256);
+  // Soft shadow or glow under a disc
+  void glow(float cx, float cy, float r, float spread, KDColor color,
+            int alpha);
+  /* Arc of a ring, with rounded caps. Angles are in turns, clockwise from 12
+   * o'clock. */
+  void arc(float cx, float cy, float r, float thickness, float start,
+           float sweep, KDColor color, int alpha = 256);
+  /* Draw a round 55x56 icon centered on (cx, cy). Icons stay compressed in
+   * flash: only the rows needed by the current band are decompressed. */
+  void icon(const uint8_t* compressedPixels, int compressedSize, float cx,
+            float cy, float scale, int alpha = 256);
+  // Text with its top-left corner at (x, y)
+  void text(const char* text, const Font& font, float x, float y,
+            KDColor color, int alpha = 256, float scale = 1.0f);
+  void centeredText(const char* text, const Font& font, float cx, float y,
+                    KDColor color, int alpha = 256, float scale = 1.0f);
+  static float textWidth(const char* text, const Font& font,
+                         float scale = 1.0f);
+  // Darken the band with a vertical gradient, used for fading edges
+  void darkenRows(int y0, int y1, int alphaAtY0, int alphaAtY1);
+
+  static KDColor mix(KDColor background, KDColor foreground,
+                     int alpha);  // alpha in [0, 256]
+  // The bubble color of a round icon, sampled away from its glyph
+  static KDColor IconTint(const uint8_t* compressedPixels, int compressedSize);
+
+ private:
+  void blendSpan(int y, int x0, int x1, KDColor color, int alpha);
+  inline void blendPixel(int x, int y, KDColor color, int alpha) {
+    if (x < m_area.left() || x >= m_area.right() || alpha <= 0) {
+      return;
+    }
+    KDColor* p = m_buffer + (y - m_bandTop) * m_area.width() +
+                 (x - m_area.left());
+    *p = alpha >= 256 ? color : mix(*p, color, alpha);
+  }
+  void glyph(const Font& font, const Font::Glyph* g, float penX, float y,
+             KDColor color, int alpha, float scale);
+  const KDColor* iconRows(const uint8_t* compressedPixels, int compressedSize,
+                          int numberOfRows);
+  void flush();
+  KDColor m_iconBuffer[k_iconPixelCount];
+  const uint8_t* m_iconInBuffer;
+  int m_iconRowsInBuffer;
+  KDRect m_area;
+  KDPoint m_origin;
+  KDColor* m_buffer;
+  int m_bandTop;
+  int m_bandBottom;
+};
+
+inline float minFloat(float a, float b) { return a < b ? a : b; }
+inline float maxFloat(float a, float b) { return a > b ? a : b; }
+inline float absFloat(float a) { return a < 0.0f ? -a : a; }
+inline float roundFloat(float a) {
+  float r = (float)(int)(a + (a < 0.0f ? -0.5f : 0.5f));
+  return r;
+}
+
+float easeOutCubic(float t);
+float easeInOutCubic(float t);
+float easeOutBack(float t);
+float clamp01(float t);
+
+}  // namespace STI2D
diff --git a/epsilon/apps/sti2d/clock.cpp b/epsilon/apps/sti2d/clock.cpp
new file mode 100644
index 0000000..b1e3343
--- /dev/null
+++ b/epsilon/apps/sti2d/clock.cpp
@@ -0,0 +1,234 @@
+#include "clock.h"
+
+#include <ion/timing.h>
+#if !PLATFORM_DEVICE
+#include <time.h>
+#endif
+
+namespace STI2D {
+namespace Clock {
+
+/* The installer looks for this magic in the firmware and writes the current
+ * UTC time (seconds since 2000-01-01) right after it. 0 means unknown. */
+struct InstallTime {
+  char magic[12];
+  uint32_t secondsSince2000;
+};
+__attribute__((used)) volatile const InstallTime k_installTime = {
+    {'S', 'T', 'I', '2', 'D', 'O', 'S', 'T', 'I', 'M', 'E', '!'}, 0};
+
+static uint32_t s_baseUTC = 0;     // Seconds since 2000-01-01, UTC
+static uint64_t s_baseMillis = 0;  // Ion::Timing::millis() at s_baseUTC
+static bool s_initialized = false;
+static bool s_isSet = false;
+static Zone s_zone = Zone::Paris;
+
+static void init() {
+  if (s_initialized) {
+    return;
+  }
+  s_initialized = true;
+  uint32_t installTime = k_installTime.secondsSince2000;
+#if !PLATFORM_DEVICE
+  // The simulator uses the clock of the computer
+  installTime = (uint32_t)(time(nullptr) - 946684800);
+  s_baseUTC = installTime;
+  s_baseMillis = Ion::Timing::millis();
+  s_isSet = true;
+  return;
+#endif
+  if (installTime != 0) {
+    /* The OS boots right after being flashed, and the clock is started at
+     * boot: the installer stamped the time at which the OS starts. */
+    s_baseUTC = installTime;
+    s_baseMillis = Ion::Timing::millis();
+    s_isSet = true;
+  } else {
+    // 2026-09-01 00:00 UTC, until the time is set in the Settings
+    s_baseUTC = 841536000;
+    s_baseMillis = Ion::Timing::millis();
+  }
+}
+
+// Days since 2000-01-01 for a civil date (proleptic Gregorian calendar)
+static int32_t daysFromCivil(int y, int m, int d) {
+  y -= m <= 2;
+  int32_t era = (y >= 0 ? y : y - 399) / 400;
+  int32_t yoe = y - era * 400;
+  int32_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  int32_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + doe - 719468 - 10957;
+}
+
+static void civilFromDays(int32_t z, int* y, int* m, int* d) {
+  z += 719468 + 10957;
+  int32_t era = (z >= 0 ? z : z - 146096) / 146097;
+  int32_t doe = z - era * 146097;
+  int32_t yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  int32_t doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  int32_t mp = (5 * doy + 2) / 153;
+  *d = doy - (153 * mp + 2) / 5 + 1;
+  *m = mp < 10 ? mp + 3 : mp - 9;
+  *y = yoe + era * 400 + (*m <= 2);
+}
+
+int daysInMonth(int year, int month) {
+  constexpr int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  if (month == 2 && ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)) {
+    return 29;
+  }
+  return days[month - 1];
+}
+
+// 0 is Monday. 2000-01-01 was a Saturday.
+static int weekDayOfDays(int32_t days) { return ((days % 7) + 7 + 5) % 7; }
+
+// Day of the month of the last Sunday of a month
+static int lastSunday(int year, int month) {
+  int last = daysInMonth(year, month);
+  int wd = weekDayOfDays(daysFromCivil(year, month, last));
+  return last - (wd + 1) % 7;
+}
+
+// Day of the month of the n-th Sunday of a month
+static int nthSunday(int year, int month, int n) {
+  int wd = weekDayOfDays(daysFromCivil(year, month, 1));
+  int firstSunday = 1 + (6 - wd);
+  return firstSunday + 7 * (n - 1);
+}
+
+struct ZoneRule {
+  int16_t standardOffsetMinutes;
+  enum class DST : uint8_t { None, Europe, NorthAmerica } dst;
+};
+
+static ZoneRule ruleOf(Zone zone) {
+  switch (zone) {
+    case Zone::Paris:
+      return {60, ZoneRule::DST::Europe};
+    case Zone::London:
+      return {0, ZoneRule::DST::Europe};
+    case Zone::NewYork:
+    case Zone::Montreal:
+      return {-300, ZoneRule::DST::NorthAmerica};
+    case Zone::Martinique:
+      return {-240, ZoneRule::DST::None};
+    case Zone::Guyane:
+      return {-180, ZoneRule::DST::None};
+    case Zone::Reunion:
+      return {240, ZoneRule::DST::None};
+    case Zone::Noumea:
+      return {660, ZoneRule::DST::None};
+    case Zone::Tahiti:
+      return {-600, ZoneRule::DST::None};
+    case Zone::Casablanca:
+    case Zone::Algiers:
+      return {60, ZoneRule::DST::None};
+    default:
+      return {0, ZoneRule::DST::None};
+  }
+}
+
+// Offset from UTC in minutes at a given UTC time
+static int offsetMinutes(Zone zone, uint32_t utc) {
+  ZoneRule rule = ruleOf(zone);
+  if (rule.dst == ZoneRule::DST::None) {
+    return rule.standardOffsetMinutes;
+  }
+  int y, m, d;
+  civilFromDays(utc / 86400, &y, &m, &d);
+  uint32_t start, end;
+  if (rule.dst == ZoneRule::DST::Europe) {
+    // From the last Sunday of March to the last Sunday of October, at 1:00 UTC
+    start = daysFromCivil(y, 3, lastSunday(y, 3)) * 86400u + 3600u;
+    end = daysFromCivil(y, 10, lastSunday(y, 10)) * 86400u + 3600u;
+  } else {
+    /* From the second Sunday of March at 2:00 standard time to the first
+     * Sunday of November at 2:00 daylight time */
+    int32_t local = 2 * 3600 - rule.standardOffsetMinutes * 60;
+    start = daysFromCivil(y, 3, nthSunday(y, 3, 2)) * 86400u + local;
+    end = daysFromCivil(y, 11, nthSunday(y, 11, 1)) * 86400u + local - 3600;
+  }
+  bool summer = utc >= start && utc < end;
+  return rule.standardOffsetMinutes + (summer ? 60 : 0);
+}
+
+static uint32_t currentUTC() {
+  init();
+  uint64_t elapsed = Ion::Timing::millis() - s_baseMillis;
+  return s_baseUTC + (uint32_t)(elapsed / 1000);
+}
+
+void start() { init(); }
+
+bool isSet() {
+  init();
+  return s_isSet;
+}
+
+DateTime now() {
+  uint32_t utc = currentUTC();
+  int64_t local = (int64_t)utc + offsetMinutes(s_zone, utc) * 60;
+  int32_t days = (int32_t)(local / 86400);
+  int32_t seconds = (int32_t)(local % 86400);
+  DateTime dt;
+  civilFromDays(days, &dt.year, &dt.month, &dt.day);
+  dt.hour = seconds / 3600;
+  dt.minute = (seconds / 60) % 60;
+  dt.second = seconds % 60;
+  dt.weekDay = weekDayOfDays(days);
+  return dt;
+}
+
+void setLocalTime(const DateTime& dt) {
+  init();
+  int64_t local = (int64_t)daysFromCivil(dt.year, dt.month, dt.day) * 86400 +
+                  dt.hour * 3600 + dt.minute * 60 + dt.second;
+  // Two passes, as the offset depends on the UTC time we are computing
+  int64_t utc = local - offsetMinutes(s_zone, (uint32_t)local) * 60;
+  utc = local - offsetMinutes(s_zone, (uint32_t)utc) * 60;
+  s_baseUTC = (uint32_t)utc;
+  s_baseMillis = Ion::Timing::millis();
+  s_isSet = true;
+}
+
+Zone zone() { return s_zone; }
+void setZone(Zone zone) { s_zone = zone; }
+
+I18n::Message zoneName(Zone zone) {
+  constexpr I18n::Message names[] = {
+      I18n::Message::ZoneParis,      I18n::Message::ZoneLondon,
+      I18n::Message::ZoneNewYork,    I18n::Message::ZoneMontreal,
+      I18n::Message::ZoneMartinique, I18n::Message::ZoneGuyane,
+      I18n::Message::ZoneReunion,    I18n::Message::ZoneNoumea,
+      I18n::Message::ZoneTahiti,     I18n::Message::ZoneCasablanca,
+      I18n::Message::ZoneAlgiers,    I18n::Message::ZoneDakar};
+  return names[static_cast<int>(zone)];
+}
+
+void zoneOffsetText(Zone zone, char* buffer, int bufferSize) {
+  int offset = offsetMinutes(zone, currentUTC());
+  int n = 0;
+  const char prefix[] = "UTC";
+  for (int i = 0; prefix[i] && n < bufferSize - 1; i++) {
+    buffer[n++] = prefix[i];
+  }
+  if (offset != 0 && n < bufferSize - 4) {
+    buffer[n++] = offset > 0 ? '+' : '-';
+    int a = offset > 0 ? offset : -offset;
+    int h = a / 60;
+    if (h >= 10) {
+      buffer[n++] = '0' + h / 10;
+    }
+    buffer[n++] = '0' + h % 10;
+    if (a % 60 != 0 && n < bufferSize - 3) {
+      buffer[n++] = ':';
+      buffer[n++] = '0' + (a % 60) / 10;
+      buffer[n++] = '0' + (a % 60) % 10;
+    }
+  }
+  buffer[n] = 0;
+}
+
+}  // namespace Clock
+}  // namespace STI2D
diff --git a/epsilon/apps/sti2d/clock.h b/epsilon/apps/sti2d/clock.h
new file mode 100644
index 0000000..0070234
--- /dev/null
+++ b/epsilon/apps/sti2d/clock.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <apps/i18n.h>
+#include <stdint.h>
+
+/* STI2D OS clock.
+ *
+ * The N0120 kernel gives the userland no access to the real-time clock, so
+ * the clock is computed from the time elapsed since boot. It starts from the
+ * time at which the OS was installed: the STI2D OS installer writes the
+ * current UTC time into the firmware right before flashing it (see
+ * k_installTime). The time can also be set by hand in the Settings. */
+
+namespace STI2D {
+namespace Clock {
+
+struct DateTime {
+  int year;
+  int month;    // 1-12
+  int day;      // 1-31
+  int hour;     // 0-23
+  int minute;   // 0-59
+  int second;   // 0-59
+  int weekDay;  // 0 is Monday
+};
+
+enum class Zone : uint8_t {
+  Paris,
+  London,
+  NewYork,
+  Montreal,
+  Martinique,
+  Guyane,
+  Reunion,
+  Noumea,
+  Tahiti,
+  Casablanca,
+  Algiers,
+  Dakar,
+  NumberOfZones
+};
+constexpr int k_numberOfZones = static_cast<int>(Zone::NumberOfZones);
+
+// Start the clock, right at boot
+void start();
+bool isSet();
+DateTime now();  // Local time in the selected zone
+void setLocalTime(const DateTime& dateTime);
+Zone zone();
+void setZone(Zone zone);
+I18n::Message zoneName(Zone zone);
+// Offset from UTC, e.g. "UTC+1", at the current date
+void zoneOffsetText(Zone zone, char* buffer, int bufferSize);
+
+int daysInMonth(int year, int month);
+
+}  // namespace Clock
+}  // namespace STI2D
diff --git a/epsilon/apps/sti2d/credits_controller.cpp b/epsilon/apps/sti2d/credits_controller.cpp
new file mode 100644
index 0000000..8ddc29b
--- /dev/null
+++ b/epsilon/apps/sti2d/credits_controller.cpp
@@ -0,0 +1,48 @@
+#include "credits_controller.h"
+
+#include <apps/i18n.h>
+
+#include "theme.h"
+
+namespace STI2D {
+
+const char* CreditsController::title() const {
+  return I18n::translate(I18n::Message::Credits);
+}
+
+void CreditsController::ContentView::drawRect(KDContext* ctx,
+                                              KDRect rect) const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(rect.intersectedWith(bounds()), absoluteOrigin(), buffer);
+  while (canvas.nextBand()) {
+    drawScene(&canvas);
+  }
+}
+
+void CreditsController::ContentView::drawScene(Canvas* canvas) const {
+  float cx = bounds().width() / 2.0f;
+  canvas->clear(KDBlack);
+  // The STI2D rings
+  constexpr float ringsY = 21.0f;
+  constexpr float sweeps[3] = {0.82f, 0.64f, 0.9f};
+  for (int i = 0; i < 3; i++) {
+    float r = 15.0f - 5.0f * i;
+    canvas->arc(cx, ringsY, r, 4.0f, 0.0f, 1.0f, k_ringColors[i], 50);
+    canvas->arc(cx, ringsY, r, 4.0f, 0.0f, sweeps[i], k_ringColors[i]);
+  }
+  canvas->centeredText("STI2D OS", k_titleFont, cx, 38.0f, KDWhite);
+  canvas->centeredText(I18n::translate(I18n::Message::CreditsLine1),
+                       k_mediumFont, cx, 73.0f, KDWhite);
+  canvas->centeredText(I18n::translate(I18n::Message::CreditsLine2),
+                       k_mediumFont, cx, 91.0f, KDWhite);
+  canvas->centeredText(I18n::translate(I18n::Message::DiscordServers),
+                       k_smallFont, cx, 115.0f, k_secondaryText);
+  canvas->centeredText(I18n::translate(I18n::Message::DiscordSTI2D),
+                       k_mediumFont, cx, 131.0f, k_accent);
+  canvas->centeredText(I18n::translate(I18n::Message::DiscordDerim),
+                       k_mediumFont, cx, 149.0f, k_accent);
+  canvas->centeredText(I18n::translate(I18n::Message::CreditsBasedOn),
+                       k_smallFont, cx, 176.0f, k_secondaryText);
+}
