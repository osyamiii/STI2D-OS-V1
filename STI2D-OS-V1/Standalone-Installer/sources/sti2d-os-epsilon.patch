+#pragma once
+
+#include <apps/i18n.h>
+#include <kandinsky/color.h>
+#include <stdint.h>
+
+#include "canvas.h"
+
+/* The look of STI2D OS, set in the Personnaliser app: the style of the watch
+ * face, its theme, the accent color and the background of the home screen.
+ * The installer website writes the initial background (a color, or a
+ * wallpaper it stores in flash) into the firmware (see k_installerConfig). */
+
+namespace STI2D {
+namespace Style {
+
+enum class Face : uint8_t { Digital, Analog, Minimal, Modular, NumberOfFaces };
+enum class Theme : uint8_t {
+  Classic,
+  Halloween,
+  Christmas,
+  Mario,
+  Minecraft,
+  ViceCity,
+  Manga,
+  Space,
+  NumberOfThemes
+};
+enum class Background : uint8_t { Color, Wallpaper, NumberOfBackgrounds };
+
+constexpr int k_numberOfFaces = static_cast<int>(Face::NumberOfFaces);
+constexpr int k_numberOfThemes = static_cast<int>(Theme::NumberOfThemes);
+constexpr int k_numberOfAccents = 10;
+constexpr int k_numberOfBackgroundColors = 8;
+
+Face face();
+void setFace(Face face);
+Theme theme();
+void setTheme(Theme theme);
+int accentIndex();
+void setAccentIndex(int index);
+// The accent color, from the palette or from the theme
+KDColor accent();
+KDColor accentAt(int index);
+
+bool hasWallpaper();
+Background background();
+void setBackground(Background background);
+// Index in the background colors, the first one being the installer's color
+int backgroundColorIndex();
+void setBackgroundColorIndex(int index);
+KDColor backgroundColorAt(int index);
+
+I18n::Message faceName(Face face);
+I18n::Message themeName(Theme theme);
+I18n::Message accentName(int index);
+I18n::Message backgroundColorName(int index);
+
+// Background of the home screen. dim darkens a wallpaper (0 to 256).
+void drawBackground(Canvas* canvas, int dim);
+// Is the background light, so that text must be dark?
+bool lightBackground();
+
+}  // namespace Style
+}  // namespace STI2D
