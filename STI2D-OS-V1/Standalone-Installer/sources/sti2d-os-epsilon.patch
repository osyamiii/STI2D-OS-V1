--- /dev/null
+++ b/tools/sti2d/package.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Build the STI2D OS installer: a single web page (WebUSB) that holds the
+custom userland for both slots of the N0120 and, optionally, STI2D-Play linked
+at the start of the external apps area of each slot.
+
+Usage: package.py <output/release/n0120> <STI2D-Play.nwa> <installer.html>"""
+import base64
+import datetime
+import gzip
+import json
+import os
+import struct
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+from dfu_elements import read_dfu  # noqa: E402
+
+BUILD, NWA, OUT = sys.argv[1], sys.argv[2], sys.argv[3]
+USERLAND_MAGIC = 0xDEC0EDFE
+INSTALL_TIME_MAGIC = b"STI2DOSTIME!"
+LEAVE = {"A": 0x90010000, "B": 0x90410000}
+
+def symbols(elf):
+    out = subprocess.check_output(["arm-none-eabi-nm", elf], text=True)
+    table = {}
+    for line in out.splitlines():
+        parts = line.split()
+        if len(parts) == 3:
+            table[parts[2]] = int(parts[0], 16)
+    return table
+
+def pack(data):
+    return base64.b64encode(gzip.compress(bytes(data), 9)).decode()
+
+slots = {}
+for slot in "AB":
+    elements = read_dfu(os.path.join(BUILD, f"userland.{slot}.dfu"))
+    address, userland = elements[0]
+    assert address == LEAVE[slot], hex(address)
+    assert struct.unpack("<I", userland[:4])[0] == USERLAND_MAGIC
+    time_offset = userland.find(INSTALL_TIME_MAGIC)
+    assert time_offset > 0 and userland.find(INSTALL_TIME_MAGIC, time_offset + 1) < 0
+    sym = symbols(os.path.join(BUILD, f"userland.{slot}.elf"))
+    apps_start, apps_end = sym["_external_apps_flash_start"], sym["_external_apps_flash_end"]
+    ram_start, ram_end = sym["_external_apps_RAM_start"], sym["_external_apps_RAM_end"]
+    with tempfile.TemporaryDirectory() as tmp:
+        bin_path = os.path.join(tmp, "apps.bin")
+        subprocess.check_call(["nwlink", "nwa-bin", NWA, bin_path,
+                               "--flash-start", hex(apps_start), "--flash-length", str(apps_end - apps_start),
+                               "--ram-start", hex(ram_start), "--ram-length", str(ram_end - ram_start)],
+                              stdout=subprocess.DEVNULL)
+        apps = open(bin_path, "rb").read()
+    assert len(apps) <= apps_end - apps_start, "STI2D-Play does not fit"
+    print(f"slot {slot}: userland {len(userland)} B, apps {len(apps)} B / {apps_end - apps_start} B "
+          f"({(apps_end - apps_start - len(apps)) // 1024} KB free)")
+    slots[slot] = {
+        "segments": [{"address": a, "data": pack(d)} for a, d in elements],
+        "versionOffset": 4,
+        "installTimeOffset": time_offset + len(INSTALL_TIME_MAGIC),
+        "appsStart": apps_start,
+        "appsEnd": apps_end,
+        "apps": {"data": pack(apps)},
+        "leave": LEAVE[slot],
+    }
+
+payload = {"build": datetime.date.today().strftime("version du %d/%m/%Y"), "slots": slots}
+html = open(os.path.join(HERE, "installer.html")).read().replace("/*PAYLOAD*/null", json.dumps(payload))
+open(OUT, "w").write(html)
+print(f"{OUT}: {os.path.getsize(OUT) / 1048576:.1f} MB")
