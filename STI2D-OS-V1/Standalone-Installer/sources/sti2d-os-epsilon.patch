+  const length = (n) => { while (n >= 255) { out.push(255); n -= 255; } out.push(n); };
+  let anchor = 0, i = 0;
+  const limit = n - 12;
+  while (i < limit) {
+    const h = hash(i), ref = table[h];
+    table[h] = i;
+    if (ref >= 0 && i - ref < 65536 && read32(ref) === read32(i)) {
+      let len = 4;
+      while (i + len < n - 5 && src[ref + len] === src[i + len]) len++;
+      const lit = i - anchor;
+      out.push((Math.min(lit, 15) << 4) | Math.min(len - 4, 15));
+      if (lit >= 15) length(lit - 15);
+      for (let k = anchor; k < i; k++) out.push(src[k]);
+      out.push((i - ref) & 255, (i - ref) >> 8);
+      if (len - 4 >= 15) length(len - 4 - 15);
+      i += len;
+      anchor = i;
+    } else {
+      i++;
+    }
+  }
+  const lit = n - anchor;
+  out.push(Math.min(lit, 15) << 4);
+  if (lit >= 15) length(lit - 15);
+  for (let k = anchor; k < n; k++) out.push(src[k]);
+  return Uint8Array.from(out);
