+#include "honeycomb_view.h"
+
+#include <apps/i18n.h>
+#include <apps/sti2d/animation.h>
+#include <apps/sti2d/clock.h>
+#include <apps/sti2d/theme.h>
+#include <assert.h>
+#include <ion.h>
+
+#include <cmath>
+
+using namespace STI2D;
+
+namespace Home {
+
+// Honeycomb geometry
+constexpr static float k_spacing = 62.0f;
+constexpr static float k_rowHeight = k_spacing * 0.8660254f;
+constexpr static float k_iconRadius = 27.0f;
+constexpr static float k_lensX = Ion::Display::Width / 2.0f;
+constexpr static float k_lensY = 136.0f;
+constexpr static float k_lensWidth = 152.0f;
+constexpr static float k_lensHeight = 104.0f;
+constexpr static float k_lensFlatZone = 0.42f;
+
+/* Slots are laid out in a spiral around the center, like on the watch: the
+ * first app is in the middle, the next six around it, and so on. */
+struct Axial {
+  int8_t q;
+  int8_t r;
+};
+
+static const Axial* spiral() {
+  static Axial slots[HoneycombView::k_maxNumberOfItems];
+  static bool computed = false;
+  if (!computed) {
+    constexpr int8_t directions[6][2] = {{1, 0},  {1, -1}, {0, -1},
+                                         {-1, 0}, {-1, 1}, {0, 1}};
+    int n = 0;
+    slots[n++] = {0, 0};
+    for (int radius = 1; n < HoneycombView::k_maxNumberOfItems; radius++) {
+      // Start on the bottom left of the ring, then walk around it
+      int q = directions[4][0] * radius;
+      int r = directions[4][1] * radius;
+      for (int side = 0; side < 6; side++) {
+        for (int step = 0;
+             step < radius && n < HoneycombView::k_maxNumberOfItems; step++) {
+          slots[n++] = {(int8_t)q, (int8_t)r};
+          q += directions[side][0];
+          r += directions[side][1];
+        }
+      }
+    }
+    computed = true;
+  }
+  return slots;
+}
+
+HoneycombView::HoneycombView(DataSource* dataSource)
+    : m_dataSource(dataSource),
+      m_numberOfItems(0),
+      m_selectedItem(0),
+      m_mode(Mode::Grid),
+      m_stickyX(0.0f),
+      m_cameraX(0.0f),
+      m_cameraY(0.0f),
+      m_gridZoom(1.0f),
+      m_gridAlpha(1.0f),
+      m_faceAlpha(0.0f),
+      m_launch(0.0f),
+      m_hour(0),
+      m_minute(0),
+      m_day(1),
+      m_month(1),
+      m_weekDay(0),
+      m_battery(100),
+      m_clockIsSet(false) {}
+
+void HoneycombView::reloadData() {
+  m_numberOfItems = m_dataSource->numberOfItems();
+  if (m_numberOfItems > k_maxNumberOfItems) {
+    m_numberOfItems = k_maxNumberOfItems;
+  }
+  if (m_selectedItem >= m_numberOfItems) {
+    m_selectedItem = 0;
+  }
+  setCameraOnItem(m_selectedItem);
+  updateClock();
+  markWholeFrameAsDirty();
+}
+
+void HoneycombView::setMode(Mode mode) {
+  m_mode = mode;
+  m_faceAlpha = mode == Mode::Face ? 1.0f : 0.0f;
+  m_gridAlpha = mode == Mode::Grid ? 1.0f : 0.0f;
+  m_gridZoom = 1.0f;
+  m_launch = 0.0f;
+  markWholeFrameAsDirty();
+}
+
+void HoneycombView::slotPosition(int slot, float* x, float* y) const {
+  const Axial a = spiral()[slot];
+  *x = k_spacing * (a.q + a.r / 2.0f);
+  *y = k_rowHeight * a.r;
+}
+
+void HoneycombView::setCameraOnItem(int index) {
+  slotPosition(index, &m_cameraX, &m_cameraY);
+}
+
+void HoneycombView::setSelectedItem(int index) {
+  assert(index >= 0 && index < k_maxNumberOfItems);
+  m_selectedItem = index;
+  setCameraOnItem(index);
+  float y;
+  slotPosition(index, &m_stickyX, &y);
+  markWholeFrameAsDirty();
+}
+
+int HoneycombView::itemAtAxial(int q, int r) const {
+  const Axial* slots = spiral();
+  for (int i = 0; i < m_numberOfItems; i++) {
+    if (slots[i].q == q && slots[i].r == r) {
+      return i;
+    }
+  }
+  return -1;
+}
+
+int HoneycombView::neighbor(Direction direction) const {
+  const Axial a = spiral()[m_selectedItem];
+  if (direction == Direction::Left || direction == Direction::Right) {
+    return itemAtAxial(a.q + (direction == Direction::Left ? -1 : 1), a.r);
+  }
+  /* Moving vertically, there are two candidates: up/down-left and
+   * up/down-right */
+  int dr = direction == Direction::Up ? -1 : 1;
+  int left = itemAtAxial(direction == Direction::Up ? a.q : a.q - 1, a.r + dr);
+  int right = itemAtAxial(direction == Direction::Up ? a.q + 1 : a.q, a.r + dr);
+  if (left < 0 || right < 0) {
+    return left < 0 ? right : left;
+  }
+  float x, y;
+  slotPosition(m_selectedItem, &x, &y);
+  float leftDistance = absFloat(x - k_spacing / 2.0f - m_stickyX);
+  float rightDistance = absFloat(x + k_spacing / 2.0f - m_stickyX);
+  if (leftDistance == rightDistance) {
+    // Lean toward the center of the honeycomb
+    return x > 0.0f ? left : right;
+  }
+  return leftDistance < rightDistance ? left : right;
+}
+
+void HoneycombView::computePlacements() const {
+  for (int i = 0; i < m_numberOfItems; i++) {
+    float wx, wy;
+    slotPosition(i, &wx, &wy);
+    float dx = (wx - m_cameraX) * m_gridZoom;
+    float dy = (wy - m_cameraY) * m_gridZoom;
+    // Fisheye lens: flat in the middle, icons shrink and gather on the edges
+    float ex = dx / k_lensWidth;
+    float ey = dy / k_lensHeight;
+    float e = std::sqrt(ex * ex + ey * ey);
+    float scale = 1.0f;
+    float pull = 1.0f;
+    if (e > k_lensFlatZone) {
+      float t = (e - k_lensFlatZone) / (1.0f - k_lensFlatZone);
+      float s = t < 1.0f ? t * t * (3.0f - 2.0f * t) : 1.0f;
+      scale = 1.0f - 0.6f * s;
+      if (t > 1.0f) {
+        scale = 0.4f * (1.0f - (t - 1.0f) / 0.7f);
+        scale = scale < 0.0f ? 0.0f : scale;
+      }
+      float tc = t < 1.6f ? t : 1.6f;
+      float compressed =
+          k_lensFlatZone + (e - k_lensFlatZone) * (1.0f - 0.22f * tc);
+      pull = compressed / e;
+    }
+    Placement* p = &m_placements[i];
+    p->x = k_lensX + dx * pull;
+    p->y = k_lensY + dy * pull;
+    p->scale = scale * m_gridZoom;
+    if (m_launch > 0.0f && i != m_selectedItem) {
+      // Other icons are blown away by the app opening
+      float push = 1.0f + 1.3f * easeInOutCubic(m_launch);
+      p->x = k_lensX + (p->x - k_lensX) * push;
+      p->y = k_lensY + (p->y - k_lensY) * push;
+    }
+  }
+}
+
+void HoneycombView::drawRect(KDContext* ctx, KDRect rect) const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(rect.intersectedWith(bounds()), absoluteOrigin(), buffer);
+  computePlacements();
+  while (canvas.nextBand()) {
+    drawScene(&canvas);
+  }
+}
+
+void HoneycombView::render() const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(bounds(), absoluteOrigin(), buffer);
+  computePlacements();
+  while (canvas.nextBand()) {
+    drawScene(&canvas);
+  }
+}
+
+void HoneycombView::drawScene(Canvas* canvas) const {
+  canvas->clear(KDBlack);
+  if (m_faceAlpha > 0.0f) {
+    drawFace(canvas);
+  }
+  if (m_gridAlpha > 0.0f) {
+    drawGrid(canvas);
+  }
+}
+
+void HoneycombView::drawGrid(Canvas* canvas) const {
+  int alpha = (int)(m_gridAlpha * 256.0f);
+  float launch = easeInOutCubic(m_launch);
+  // The selected app is drawn last, so that it opens above the others
+  for (int k = 0; k < m_numberOfItems; k++) {
+    int i = k < m_selectedItem
+                ? k
+                : (k == m_numberOfItems - 1 ? m_selectedItem : k + 1);
+    const Placement& p = m_placements[i];
+    if (p.scale <= 0.02f) {
+      continue;
+    }
+    bool selected = i == m_selectedItem;
+    int itemAlpha = alpha;
+    float scale = p.scale;
+    int iconSize = 0;
+    const uint8_t* icon = m_dataSource->iconForItem(i, &iconSize);
+    KDColor tint = m_dataSource->tintForItem(i);
+    if (selected && m_launch == 0.0f) {
+      // A soft glow of the app color lifts the selected app up
+      canvas->glow(p.x, p.y, k_iconRadius * scale, 14.0f, tint, alpha / 3);
+    }
+    if (m_launch > 0.0f) {
+      if (!selected) {
+        itemAlpha = (int)(alpha * (1.0f - clamp01(m_launch * 1.6f)));
+      } else {
+        // The opened app grows from its icon until it fills the screen
+        scale *= 1.0f + 7.5f * launch;
+        canvas->fillCircle(p.x, p.y, k_iconRadius * scale, tint,
+                           (int)(alpha * clamp01(m_launch * 3.0f)));
+        itemAlpha = (int)(alpha * (1.0f - clamp01(m_launch * 1.8f)));
+      }
+    }
+    if (itemAlpha <= 0) {
+      continue;
+    }
+    if (icon) {
+      canvas->icon(icon, iconSize, p.x, p.y, scale, itemAlpha);
+    } else {
+      canvas->fillCircle(p.x, p.y, k_iconRadius * scale, tint, itemAlpha);
+      const char* name = m_dataSource->nameForItem(i);
+      char initial[2] = {name[0], 0};
+      canvas->centeredText(initial, k_titleFont, p.x,
+                           p.y - k_titleFont.lineHeight() * scale / 2.0f,
+                           KDWhite, itemAlpha, scale);
+    }
+    if (selected && m_launch == 0.0f && m_mode == Mode::Grid) {
+      // A thin halo marks the selected app
+      canvas->arc(p.x, p.y, k_iconRadius * scale + 3.5f, 1.8f, 0.0f, 1.0f,
+                  KDWhite, alpha * 3 / 4);
+    }
+  }
+  drawHeader(canvas, (int)(alpha * (1.0f - clamp01(m_launch * 2.0f))));
+}
+
+static void formatTwoDigits(char* buffer, int value) {
+  buffer[0] = '0' + (value / 10) % 10;
+  buffer[1] = '0' + value % 10;
+}
+
+void HoneycombView::drawHeader(Canvas* canvas, int alpha) const {
+  if (alpha <= 0 || canvas->top() >= k_headerHeight) {
+    return;
+  }
+  // Icons fade out under the header, like under the watch status bar
+  canvas->darkenRows(0, k_headerHeight, alpha, 0);
+  const char* name = m_dataSource->nameForItem(m_selectedItem);
+  canvas->text(name, k_mediumFont, 12.0f, 6.0f, k_accent, alpha);
+  char time[6] = "--:--";
+  if (m_clockIsSet) {
+    formatTwoDigits(time, m_hour);
+    formatTwoDigits(time + 3, m_minute);
+  }
+  float w = Canvas::textWidth(time, k_mediumFont);
+  canvas->text(time, k_mediumFont, roundFloat(Ion::Display::Width - 12.0f - w),
+               6.0f, KDWhite, alpha);
+}
+
+void HoneycombView::drawFace(Canvas* canvas) const {
+  int alpha = (int)(m_faceAlpha * 256.0f);
+  constexpr float cx = Ion::Display::Width / 2.0f;
+  // Date
+  char date[40];
+  const char* day = I18n::translate(
+      (I18n::Message)((int)I18n::Message::STI2DDay0 + m_weekDay));
+  const char* month = I18n::translate(
+      (I18n::Message)((int)I18n::Message::STI2DMonth00 + m_month - 1));
+  int n = 0;
+  for (const char* c = day; *c && n < 16; c++) {
+    date[n++] = *c;
+  }
+  date[n++] = ' ';
+  if (m_day >= 10) {
+    date[n++] = '0' + m_day / 10;
+  }
+  date[n++] = '0' + m_day % 10;
+  date[n++] = ' ';
+  for (const char* c = month; *c && n < 38; c++) {
+    date[n++] = *c;
+  }
+  date[n] = 0;
+  canvas->centeredText(date, k_mediumFont, cx, 26.0f, k_accent, alpha);
+
+  // Big time
+  char time[6] = "--:--";
+  if (m_clockIsSet) {
+    formatTwoDigits(time, m_hour);
+    formatTwoDigits(time + 3, m_minute);
+  }
+  canvas->centeredText(time, k_clockFont, cx, 44.0f, KDWhite, alpha);
+
+  // Complications: battery on the left, the STI2D rings on the right
+  constexpr float complicationY = 200.0f;
+  constexpr float batteryX = 50.0f;
+  KDColor batteryColor = (m_battery < 20 && !Ion::Battery::isCharging())
+                             ? k_red
+                             : k_green;
+  canvas->arc(batteryX, complicationY, 19.0f, 5.0f, 0.0f, 1.0f, batteryColor,
+              alpha / 4);
+  canvas->arc(batteryX, complicationY, 19.0f, 5.0f, 0.0f,
+              m_battery / 100.0f * 0.999f, batteryColor, alpha);
+  char percent[5];
+  int p = 0;
+  if (m_battery >= 100) {
+    percent[p++] = '1';
+  }
+  if (m_battery >= 10) {
+    percent[p++] = '0' + (m_battery / 10) % 10;
+  }
+  percent[p++] = '0' + m_battery % 10;
+  percent[p] = 0;
+  canvas->centeredText(percent, k_smallFont, batteryX, complicationY - 8.0f,
+                       KDWhite, alpha);
+
+  constexpr float ringsX = Ion::Display::Width - 50.0f;
+  constexpr float sweeps[3] = {0.82f, 0.64f, 0.9f};
+  for (int i = 0; i < 3; i++) {
+    float r = 19.0f - 6.0f * i;
+    canvas->arc(ringsX, complicationY, r, 5.0f, 0.0f, 1.0f, k_ringColors[i],
+                alpha / 5);
+    canvas->arc(ringsX, complicationY, r, 5.0f, 0.0f, sweeps[i],
+                k_ringColors[i], alpha);
+  }
+
+  canvas->centeredText("STI2D OS", k_mediumFont, cx, complicationY - 18.0f,
+                       KDWhite, alpha);
+  canvas->centeredText(I18n::translate(I18n::Message::STI2DFaceHint),
+                       k_smallFont, cx, complicationY + 2.0f, k_secondaryText,
+                       alpha);
+  if (!m_clockIsSet) {
+    canvas->centeredText(I18n::translate(I18n::Message::STI2DSetTime),
+                         k_smallFont, cx, 126.0f, k_accent, alpha);
+  }
+}
+
+bool HoneycombView::updateClock() {
+  Clock::DateTime now = Clock::now();
+  float voltage = Ion::Battery::voltage();
+  int battery = (int)((voltage - 3.6f) / (4.15f - 3.6f) * 100.0f + 0.5f);
+  battery = battery < 0 ? 0 : (battery > 100 ? 100 : battery);
+  bool isSet = Clock::isSet();
+  bool changed = now.hour != m_hour || now.minute != m_minute ||
+                 now.day != m_day || battery != m_battery ||
+                 isSet != m_clockIsSet;
+  m_hour = now.hour;
+  m_minute = now.minute;
+  m_day = now.day;
+  m_month = now.month;
+  m_weekDay = now.weekDay;
+  m_battery = battery;
+  m_clockIsSet = isSet;
+  return changed;
+}
+
+bool HoneycombView::refreshClock() {
+  if (!updateClock()) {
+    return false;
+  }
+  markRectAsDirty(m_mode == Mode::Face
+                      ? bounds()
+                      : KDRect(0, 0, bounds().width(), k_headerHeight));
+  return true;
+}
+
+template <typename F>
+void HoneycombView::animate(float duration, F step) {
+  startAnimation();
+  uint64_t start = Ion::Timing::millis();
+  uint64_t previousKeys = Ion::Keyboard::scan();
+  while (true) {
+    float t = clamp01(frameTime(start) / duration);
+    step(t);
+    Ion::Display::waitForVBlank();
+    render();
+    if (animationsFrozen()) {
+      holdFrozenFrame();
+      return;
+    }
+    if (t >= 1.0f) {
+      return;
+    }
+    uint64_t keys = Ion::Keyboard::scan();
+    if (keys & ~previousKeys) {
+      /* A new key went down: jump to the end of the animation so that the key
+       * is handled right away. The OS never makes the user wait. */
+      step(1.0f);
+      render();
+      return;
+    }
+    previousKeys = keys;
+  }
+}
+
+void HoneycombView::animateSelectionTo(int index) {
+  if (index < 0 || index == m_selectedItem) {
+    return;
+  }
+  float fromX = m_cameraX, fromY = m_cameraY;
+  float toX, toY;
+  slotPosition(index, &toX, &toY);
+  m_selectedItem = index;
+  animate(200.0f, [&](float t) {
+    // A hint of overshoot gives the honeycomb some weight
+    float e = 1.0f + (easeOutBack(t) - 1.0f) * 0.45f;
+    m_cameraX = fromX + (toX - fromX) * e;
+    m_cameraY = fromY + (toY - fromY) * e;
+  });
+  m_cameraX = toX;
+  m_cameraY = toY;
+}
+
+void HoneycombView::animateToGrid() {
+  m_mode = Mode::Grid;
+  animate(420.0f, [&](float t) {
+    m_faceAlpha = 1.0f - clamp01(t * 2.5f);
+    m_gridAlpha = clamp01(t * 2.0f);
+    m_gridZoom = 0.35f + 0.65f * easeOutBack(t);
+  });
+}
+
+void HoneycombView::animateToFace() {
+  m_mode = Mode::Face;
+  animate(360.0f, [&](float t) {
+    float out = easeInOutCubic(clamp01(t / 0.6f));
+    m_gridZoom = 1.0f + 1.2f * out;
+    m_gridAlpha = 1.0f - out;
+    m_faceAlpha = clamp01((t - 0.4f) / 0.6f);
+  });
+  m_gridZoom = 1.0f;
+}
+
+void HoneycombView::animateLaunch() {
+  animate(280.0f, [&](float t) { m_launch = t; });
+  m_launch = 0.0f;
+}
+
+}  // namespace Home
diff --git a/epsilon/apps/home/honeycomb_view.h b/epsilon/apps/home/honeycomb_view.h
new file mode 100644
index 0000000..638fab4
--- /dev/null
+++ b/epsilon/apps/home/honeycomb_view.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <apps/sti2d/canvas.h>
+#include <escher/view.h>
+
+namespace Home {
+
+/* The STI2D OS home screen, modeled after the Apple Watch:
+ * - a watch face (big clock, date, battery complication),
+ * - a honeycomb of round app icons. The selected app sits at the center of a
+ *   fisheye lens: icons shrink and gather as they get closer to the edges of
+ *   the screen, and the whole honeycomb glides when the selection moves.
+ * The view renders itself with the STI2D canvas (see apps/sti2d/canvas.h). */
+
+class HoneycombView : public Escher::View {
+ public:
+  class DataSource {
+   public:
+    virtual int numberOfItems() = 0;
+    // Compressed 55x56 pixels, or nullptr
+    virtual const uint8_t* iconForItem(int index, int* compressedSize) = 0;
+    virtual KDColor tintForItem(int index) = 0;
+    virtual const char* nameForItem(int index) = 0;
+  };
+  enum class Mode : uint8_t { Face, Grid };
+  enum class Direction : uint8_t { Left, Right, Up, Down };
+  constexpr static int k_maxNumberOfItems = 61;  // Center + 4 rings
+  constexpr static int k_headerHeight = 32;
+
+  HoneycombView(DataSource* dataSource);
+  void drawRect(KDContext* ctx, KDRect rect) const override;
+
+  Mode mode() const { return m_mode; }
+  void setMode(Mode mode);
+  int selectedItem() const { return m_selectedItem; }
+  void setSelectedItem(int index);  // Without animation
+  int neighbor(Direction direction) const;
+  void reloadData();
+
+  // Blocking animations, drawn straight to the screen frame after frame
+  void animateSelectionTo(int index);
+  void animateToGrid();
+  void animateToFace();
+  void animateLaunch();
+
+  // Redraw the clock shown on the face and in the header if it changed
+  bool refreshClock();
+
+ private:
+  struct Placement {
+    float x;
+    float y;
+    float scale;
+  };
+  bool updateClock();
+  void render() const;
+  void drawScene(STI2D::Canvas* canvas) const;
+  void drawGrid(STI2D::Canvas* canvas) const;
+  void drawFace(STI2D::Canvas* canvas) const;
+  void drawHeader(STI2D::Canvas* canvas, int alpha) const;
+  void computePlacements() const;
+  void slotPosition(int slot, float* x, float* y) const;
+  int itemAtAxial(int q, int r) const;
+  void setCameraOnItem(int index);
+  template <typename F>
+  void animate(float duration, F step);
+
+  DataSource* m_dataSource;
+  int m_numberOfItems;
+  int m_selectedItem;
+  Mode m_mode;
+  float m_stickyX;  // Preferred column when moving up and down
+  // Animated state
+  float m_cameraX;
+  float m_cameraY;
+  float m_gridZoom;
+  float m_gridAlpha;
+  float m_faceAlpha;
+  float m_launch;
+  // Clock
+  int m_hour;
+  int m_minute;
+  int m_day;
+  int m_month;
+  int m_weekDay;
+  int m_battery;
+  bool m_clockIsSet;
+  // Caches
+  mutable Placement m_placements[k_maxNumberOfItems];
+};
+
+}  // namespace Home
