+#pragma once
+
+#include <apps/sti2d/canvas.h>
+#include <escher/view.h>
+#include <escher/view_controller.h>
+
+#include "engine.h"
+
+namespace Sms {
+
+class Controller : public Escher::ViewController {
+ public:
+  Controller(Escher::Responder* parentResponder);
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+
+ private:
+  enum class Mode : uint8_t { Contacts, Chat };
+
+  class ContentView : public Escher::View {
+   public:
+    ContentView(Controller* controller) : m_controller(controller) {}
+    void drawRect(KDContext* ctx, KDRect rect) const override;
+    void reload() { markWholeFrameAsDirty(); }
+    void render() const;
+
+   private:
+    void drawContacts(STI2D::Canvas* canvas) const;
+    void drawChat(STI2D::Canvas* canvas) const;
+    Controller* m_controller;
+  };
+
+  bool handleContactsEvent(Ion::Events::Event event);
+  bool handleChatEvent(Ion::Events::Event event);
+  void openChat(int character);
+  void send(const char* text);
+
+  ContentView m_view;
+  Mode m_mode;
+  int m_selectedContact;
+  int m_quickReply;
+  int m_scroll;  // Pixels scrolled up from the latest message
+  int m_typingDots;  // > 0 while the character is typing
+  char m_input[Engine::k_textSize];
+};
+
+}  // namespace Sms
diff --git a/epsilon/apps/sms/engine.cpp b/epsilon/apps/sms/engine.cpp
new file mode 100644
index 0000000..5040b81
--- /dev/null
+++ b/epsilon/apps/sms/engine.cpp
@@ -0,0 +1,317 @@
+#include "engine.h"
+
+#include <apps/sti2d/clock.h>
+#include <ion.h>
+#include <omg/utf8_decoder.h>
+#include <string.h>
+
+extern "C" int LZ4_decompress_safe(const char* src, char* dst, int srcSize,
+                                   int dstCapacity);
+
+namespace Sms {
+
+using namespace Library;
+
+constexpr static int k_blockBufferSize = 4096;
+
+const char* Engine::text(int id) {
+  uint16_t location = k_strings[id];
+  int block = location >> 12;
+  if (block != m_blockInBuffer) {
+    LZ4_decompress_safe(reinterpret_cast<const char*>(k_blocks[block].data),
+                        m_blockBuffer, k_blocks[block].compressedSize,
+                        k_blockBufferSize);
+    m_blockInBuffer = block;
+  }
+  return m_blockBuffer + (location & 0xFFF);
+}
+
+static uint32_t random32() { return Ion::random(); }
+
+/* Lowercase, without accents, so that "Ça" matches "ca". The calculator
+ * types its multiplication sign as ×. */
+static void normalize(const char* message, char* out, int size) {
+  int n = 0;
+  UTF8Decoder decoder(message);
+  for (CodePoint c = decoder.nextCodePoint(); c != UCodePointNull && n < size - 3;
+       c = decoder.nextCodePoint()) {
+    uint32_t code = c;
+    const char* replacement = nullptr;
+    char single = 0;
+    if (code < 0x80) {
+      single = (code >= 'A' && code <= 'Z') ? (char)(code + 32) : (char)code;
+    } else if (code == 0xD7) {
+      single = '*';
+    } else if (code == 0xF7) {
+      single = '/';
+    } else if (code == 0x153 || code == 0x152) {
+      replacement = "oe";
+    } else if (code == 0x2019) {
+      single = '\'';
+    } else if (code >= 0xC0 && code <= 0xFF) {
+      constexpr const char* latin =
+          "aaaaaaaceeeeiiiidnooooo*ouuuuyts"   // 0xC0 - 0xDF
+          "aaaaaaaceeeeiiiidnooooo/ouuuuyty";  // 0xE0 - 0xFF
+      single = latin[code - 0xC0];
+    } else if (CodePoint(code).isCombining()) {
+      continue;
+    }
+    if (replacement) {
+      out[n++] = replacement[0];
+      out[n++] = replacement[1];
+    } else if (single) {
+      out[n++] = single;
+    }
+  }
+  out[n] = 0;
+}
+
+static bool isLetter(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
+}
+
+// Does the keyword appear in the text, at the start of a word?
+static bool contains(const char* text, const char* keyword, int length) {
+  for (const char* p = text; *p; p++) {
+    if ((p == text || !isLetter(p[-1])) && strncmp(p, keyword, length) == 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+int Engine::findTopic(const char* normalized) {
+  int best = -1, bestScore = 0;
+  for (int t = 0; t < k_numberOfTopics - 2; t++) {
+    int score = 0;
+    const char* keywords = k_topicKeywords[t];
+    while (*keywords) {
+      const char* end = strchr(keywords, '|');
+      int length = end ? end - keywords : strlen(keywords);
+      if (length > 0 && contains(normalized, keywords, length)) {
+        // Longer keywords are more specific
+        score += length;
+      }
+      keywords += length + (end ? 1 : 0);
+    }
+    if (score > bestScore) {
+      best = t;
+      bestScore = score;
+    }
+  }
+  return best;
+}
+
+int Engine::pick(Range range, Memory* memory) {
+  int choice = range.start + random32() % range.count;
+  // Try a few times to avoid what was said recently
+  for (int attempt = 0; attempt < 6; attempt++) {
+    int id = k_ids[choice];
+    bool recent = false;
+    for (uint16_t r : memory->recent) {
+      recent |= r == id + 1;
+    }
+    if (!recent) {
+      break;
+    }
+    choice = range.start + random32() % range.count;
+  }
+  int id = k_ids[choice];
+  memory->recent[memory->recentIndex] = id + 1;
+  memory->recentIndex = (memory->recentIndex + 1) % 10;
+  return id;
+}
+
+static void append(char* buffer, int* n, const char* text) {
+  while (*text && *n < Engine::k_textSize - 1) {
+    buffer[(*n)++] = *text++;
+  }
+  buffer[*n] = 0;
+}
+
+void Engine::compose(int c, int textId, bool decorate, Memory* memory,
+                     const char* result, char* buffer) {
+  const Character& who = k_characters[c];
+  char body[k_textSize];
+  strlcpy(body, text(textId), sizeof(body));
+  int n = 0;
+  buffer[0] = 0;
+  bool prefixed = decorate && who.prefixes.count && random32() % 100 < 30;
+  if (prefixed) {
+    append(buffer, &n, text(pick(who.prefixes, memory)));
+  }
+  // Fill the placeholders
+  for (const char* p = body; *p;) {
+    if (p[0] == '{') {
+      const char* end = strchr(p, '}');
+      if (end) {
+        char value[24] = {0};
+        if (strncmp(p, "{name}", 6) == 0) {
+          strlcpy(value, memory->userName[0] ? memory->userName : who.nickname, sizeof(value));
+        } else if (strncmp(p, "{result}", 8) == 0) {
+          strlcpy(value, result ? result : "?", sizeof(value));
+        } else if (strncmp(p, "{time}", 6) == 0 || strncmp(p, "{date}", 6) == 0) {
+          STI2D::Clock::DateTime now = STI2D::Clock::now();
+          bool time = p[1] == 't';
+          int a = time ? now.hour : now.day, b = time ? now.minute : now.month;
+          value[0] = '0' + a / 10;
+          value[1] = '0' + a % 10;
+          value[2] = time ? ':' : '/';
+          value[3] = '0' + b / 10;
+          value[4] = '0' + b % 10;
+        }
+        append(buffer, &n, value);
+        p = end + 1;
+        continue;
+      }
+    }
+    // A prefix such as "Frérot, " is followed by a lowercase letter
+    if (prefixed && p == body && *p >= 'A' && *p <= 'Z' && p[1] >= 'a' && p[1] <= 'z') {
+      char lower[2] = {(char)(*p + 32), 0};
+      append(buffer, &n, lower);
+    } else {
+      char one[2] = {*p, 0};
+      append(buffer, &n, one);
+    }
+    p++;
+  }
+  if (decorate && who.suffixes.count && random32() % 100 < 35) {
+    append(buffer, &n, text(pick(who.suffixes, memory)));
+  }
+}
+
+// Find "12*7", "3 + 4", "10/4" in a message and compute it
+static bool calculation(const char* s, char* result) {
+  for (const char* p = s; *p; p++) {
+    if (*p < '0' || *p > '9' || (p > s && p[-1] >= '0' && p[-1] <= '9')) {
+      continue;
+    }
+    const char* q = p;
+    double a = 0;
+    while (*q >= '0' && *q <= '9') {
+      a = a * 10 + (*q++ - '0');
+    }
+    while (*q == ' ') q++;
+    char op = *q;
+    if (op != '+' && op != '-' && op != '*' && op != '/' && op != 'x') {
+      continue;
+    }
+    q++;
+    while (*q == ' ') q++;
+    if (*q < '0' || *q > '9') {
+      continue;
+    }
+    double b = 0;
+    while (*q >= '0' && *q <= '9') {
+      b = b * 10 + (*q++ - '0');
+    }
+    double r = op == '+' ? a + b : op == '-' ? a - b : op == '/' ? (b != 0 ? a / b : 0) : a * b;
+    if (op == '/' && b == 0) {
+      strlcpy(result, "l'infini… ou une erreur", 32);
+      return true;
+    }
+    // Two decimals at most
+    long long cents = (long long)(r * 100 + (r < 0 ? -0.5 : 0.5));
+    int n = 0;
+    char digits[24];
+    if (cents < 0) {
+      result[n++] = '-';
+      cents = -cents;
+    }
+    long long whole = cents / 100;
+    int d = 0;
+    do {
+      digits[d++] = '0' + whole % 10;
+      whole /= 10;
+    } while (whole > 0 && d < 18);
+    while (d > 0) {
+      result[n++] = digits[--d];
+    }
+    if (cents % 100) {
+      result[n++] = ',';
+      result[n++] = '0' + (cents % 100) / 10;
+      if (cents % 10) {
+        result[n++] = '0' + cents % 10;
+      }
+    }
+    result[n] = 0;
+    return true;
+  }
+  return false;
+}
+
+static const char* find(const char* text, const char* pattern) {
+  int length = strlen(pattern);
+  for (const char* p = text; *p; p++) {
+    if (strncmp(p, pattern, length) == 0) {
+      return p;
+    }
+  }
+  return nullptr;
+}
+
+// "je m'appelle Lucas", "moi c'est Lucas", "mon nom est Lucas"
+static bool introduction(const char* normalized, const char* original, char* name) {
+  constexpr const char* patterns[] = {"je m'appelle ", "moi c'est ", "mon nom est ", "mon prenom est "};
+  for (const char* pattern : patterns) {
+    const char* found = find(normalized, pattern);
+    if (!found) {
+      continue;
+    }
+    const char* start = found + strlen(pattern);
+    int n = 0;
+    while (isLetter(start[n]) && n < 14) {
+      name[n] = start[n];
+      n++;
+    }
+    name[n] = 0;
+    if (n == 0) {
+      return false;
+    }
+    if (name[0] >= 'a' && name[0] <= 'z') {
+      name[0] -= 32;
+    }
+    return true;
+  }
+  return false;
+}
+
+void Engine::reply(int c, const char* message, Memory* memory, char* buffer) {
+  const Character& who = k_characters[c];
+  char normalized[k_textSize];
+  normalize(message, normalized, sizeof(normalized));
+  char result[32];
+  int topic;
+  if (introduction(normalized, message, memory->userName)) {
+    topic = k_nameTopic;
+  } else if (calculation(normalized, result)) {
+    topic = k_calculTopic;
+  } else {
+    topic = findTopic(normalized);
+  }
+  if (topic < 0) {
+    compose(c, pick(k_fallback, memory), true, memory, nullptr, buffer);
+    return;
+  }
+  Range own = who.topics[topic];
+  Range shared = k_shared[topic];
+  // The character's own words first, the shared replies sometimes
+  bool useOwn = own.count > 0 && (shared.count == 0 || random32() % 100 < 75);
+  if (useOwn) {
+    compose(c, pick(own, memory), false, memory, result, buffer);
+  } else if (shared.count > 0) {
+    compose(c, pick(shared, memory), true, memory, result, buffer);
+  } else {
+    compose(c, pick(k_fallback, memory), true, memory, nullptr, buffer);
+  }
+}
+
+void Engine::greeting(int c, Memory* memory, char* buffer) {
+  compose(c, pick(k_characters[c].greetings, memory), false, memory, nullptr, buffer);
+}
+
+void Engine::quickReply(int index, char* buffer) {
+  strlcpy(buffer, text(k_ids[Library::k_quickReplies.start + index]), k_textSize);
+}
+
+}  // namespace Sms
