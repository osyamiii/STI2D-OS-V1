+# The honeycomb of the home screen, to plan valid moves (see honeycomb_view.cpp)
+NUMBER_OF_ITEMS = 13  # 12 NumWorks apps and STI2D-Play
+
+def spiral(n):
+    dirs = [(1, 0), (1, -1), (0, -1), (-1, 0), (-1, 1), (0, 1)]
+    slots, radius = [(0, 0)], 1
+    while len(slots) < n:
+        q, r = -radius, radius
+        for side in range(6):
+            for _ in range(radius):
+                slots.append((q, r))
+                q, r = q + dirs[side][0], r + dirs[side][1]
+        radius += 1
+    return slots[:n]
+
+SLOTS = spiral(NUMBER_OF_ITEMS)
+
+def move(item, sticky, key):
+    q, r = SLOTS[item]
+    x = lambda i: SLOTS[i][0] + SLOTS[i][1] / 2
+    at = lambda qq, rr: SLOTS.index((qq, rr)) if (qq, rr) in SLOTS else -1
+    if key in (LEFT, RIGHT):
+        n = at(q + (-1 if key == LEFT else 1), r)
+        return n, (x(n) if n >= 0 else sticky)
+    dr = -1 if key == UP else 1
+    left = at(q if key == UP else q - 1, r + dr)
+    right = at(q + 1 if key == UP else q, r + dr)
+    if left < 0 or right < 0:
+        return (right if left < 0 else left), sticky
+    dl, drr = abs(x(item) - 0.5 - sticky), abs(x(item) + 0.5 - sticky)
+    if dl == drr:
+        return (left if x(item) > 0 else right), sticky
+    return (left if dl < drr else right), sticky
+
+def valid_moves(keys):
+    """Keep the keys that move the selection."""
+    item, sticky, kept = 0, 0.0, []
+    for key in keys:
+        n, sticky2 = move(item, sticky, key)
+        if n >= 0:
+            item, sticky = n, sticky2
+            kept.append(key)
+    return kept
+
