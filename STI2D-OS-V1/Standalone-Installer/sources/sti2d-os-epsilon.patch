+#pragma once
+
+#include <escher/view.h>
+#include <escher/view_controller.h>
+
+#include "canvas.h"
+#include "clock.h"
+
+namespace STI2D {
+
+/* Settings > Date and time: choose the time zone (Paris by default) and set
+ * the time and the date. */
+class DateTimeController : public Escher::ViewController {
+ public:
+  DateTimeController(Escher::Responder* parentResponder);
+  const char* title() const override;
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+
+ private:
+  enum class Row : uint8_t { Zone, Time, Date };
+  constexpr static int k_numberOfRows = 3;
+
+  class ContentView : public Escher::View {
+   public:
+    ContentView(DateTimeController* controller) : m_controller(controller) {}
+    void drawRect(KDContext* ctx, KDRect rect) const override;
+    void reload() { markWholeFrameAsDirty(); }
+
+   private:
+    void drawScene(Canvas* canvas) const;
+    DateTimeController* m_controller;
+  };
+
+  void changeField(int delta);
+  int numberOfFields() const;
+
+  ContentView m_view;
+  Row m_row;
+  bool m_editing;
+  int m_field;
+  Clock::DateTime m_edited;
+};
+
+}  // namespace STI2D
