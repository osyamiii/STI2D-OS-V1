+#pragma once
+
+#include <escher/app.h>
+#include <escher/container.h>
+
+#include "controller.h"
+#include "engine.h"
+
+namespace Sms {
+
+/* SMS: chat with characters of STI2D OS. The conversation is kept in the
+ * snapshot (a few kilobytes of RAM), never in the calculator's storage. */
+class App : public Escher::App {
+ public:
+  constexpr static int k_maxNumberOfMessages = 14;
+  struct Message {
+    bool mine;
+    char text[Engine::k_textSize];
+  };
+
+  class Descriptor : public Escher::App::Descriptor {
+   public:
+    I18n::Message name() const override;
+    I18n::Message upperName() const override;
+    Escher::ThemedImage icon() const override;
+  };
+  class Snapshot : public Escher::App::Snapshot {
+   public:
+    App* unpack(Escher::Container* container) override;
+    const Descriptor* descriptor() const override;
+    int character() const { return m_character; }
+    void setCharacter(int character);
+    int numberOfMessages() const { return m_numberOfMessages; }
+    const Message& message(int i) const { return m_messages[i]; }
+    void addMessage(bool mine, const char* text);
+    Engine::Memory* memory() { return &m_memory; }
+
+   private:
+    int m_character = -1;
+    int m_numberOfMessages = 0;
+    Message m_messages[k_maxNumberOfMessages];
+    Engine::Memory m_memory = {};
+  };
+  static App* app() { return static_cast<App*>(Escher::App::app()); }
+  Snapshot* snapshot() {
+    return static_cast<Snapshot*>(Escher::App::snapshot());
+  }
+  Engine* engine() { return &m_engine; }
+
+ private:
+  App(Snapshot* snapshot);
+  char m_blockBuffer[4096];
+  Engine m_engine;
+  Controller m_controller;
+};
+
+}  // namespace Sms
diff --git a/epsilon/apps/sms/controller.cpp b/epsilon/apps/sms/controller.cpp
new file mode 100644
index 0000000..aad7bf8
--- /dev/null
+++ b/epsilon/apps/sms/controller.cpp
@@ -0,0 +1,352 @@
+#include "controller.h"
+
+#include <apps/i18n.h>
+#include <apps/sti2d/animation.h>
+#include <apps/sti2d/style.h>
+#include <apps/sti2d/theme.h>
+#include <ion.h>
+#include <omg/utf8_decoder.h>
+#include <string.h>
+
+#include "app.h"
+
+using namespace STI2D;
+
+namespace Sms {
+
+constexpr static KDColor k_mine = KDColor::RGB24(0x0A84FF);
+constexpr static KDColor k_theirs = KDColor::RGB24(0x26252A);
+constexpr static KDColor k_bar = KDColor::RGB24(0x1C1C1E);
+constexpr static float k_width = Ion::Display::Width;
+constexpr static float k_height = Ion::Display::Height;
+constexpr static float k_headerHeight = 36;
+constexpr static float k_inputTop = 204;
+constexpr static float k_rowHeight = 50;
+constexpr static float k_bubbleMaxWidth = 228;
+constexpr static float k_lineHeight = 16;
+constexpr static int k_maxLines = 8;
+
+Controller::Controller(Escher::Responder* parentResponder)
+    : ViewController(parentResponder),
+      m_view(this),
+      m_mode(Mode::Contacts),
+      m_selectedContact(0),
+      m_quickReply(0),
+      m_scroll(0),
+      m_typingDots(0),
+      m_input{0} {}
+
+void Controller::viewWillAppear() {
+  ViewController::viewWillAppear();
+  // Back to the list of contacts, the last conversation selected
+  int character = App::app()->snapshot()->character();
+  m_mode = Mode::Contacts;
+  if (character >= 0) {
+    m_selectedContact = character;
+  }
+  m_view.reload();
+}
+
+bool Controller::handleEvent(Ion::Events::Event event) {
+  bool handled = m_mode == Mode::Contacts ? handleContactsEvent(event)
+                                          : handleChatEvent(event);
+  if (handled) {
+    m_view.reload();
+  }
+  return handled;
+}
+
+bool Controller::handleContactsEvent(Ion::Events::Event event) {
+  int n = Library::k_numberOfCharacters;
+  if (event == Ion::Events::Up || event == Ion::Events::Down) {
+    m_selectedContact = (m_selectedContact + (event == Ion::Events::Down ? 1 : n - 1)) % n;
+    return true;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE || event == Ion::Events::Right) {
+    openChat(m_selectedContact);
+    return true;
+  }
+  return false;
+}
+
+void Controller::openChat(int character) {
+  App::Snapshot* snapshot = App::app()->snapshot();
+  bool fresh = snapshot->character() != character || snapshot->numberOfMessages() == 0;
+  snapshot->setCharacter(character);
+  m_mode = Mode::Chat;
+  m_scroll = 0;
+  m_input[0] = 0;
+  if (fresh) {
+    char greeting[Engine::k_textSize];
+    App::app()->engine()->greeting(character, snapshot->memory(), greeting);
+    snapshot->addMessage(false, greeting);
+  }
+}
+
+static void removeLastCodePoint(char* text) {
+  int n = strlen(text);
+  if (n == 0) {
+    return;
+  }
+  n--;
+  // Skip the continuation bytes of a UTF-8 sequence
+  while (n > 0 && (static_cast<uint8_t>(text[n]) & 0xC0) == 0x80) {
+    n--;
+  }
+  text[n] = 0;
+}
+
+bool Controller::handleChatEvent(Ion::Events::Event event) {
+  Engine* engine = App::app()->engine();
+  if (event == Ion::Events::Back) {
+    if (m_input[0]) {
+      m_input[0] = 0;
+      return true;
+    }
+    m_mode = Mode::Contacts;
+    return true;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    if (m_input[0]) {
+      send(m_input);
+      m_input[0] = 0;
+    } else {
+      char quick[Engine::k_textSize];
+      engine->quickReply(m_quickReply, quick);
+      send(quick);
+      m_quickReply = (m_quickReply + 1) % engine->numberOfQuickReplies();
+    }
+    return true;
+  }
+  if ((event == Ion::Events::Left || event == Ion::Events::Right) && !m_input[0]) {
+    int n = engine->numberOfQuickReplies();
+    m_quickReply = (m_quickReply + (event == Ion::Events::Right ? 1 : n - 1)) % n;
+    return true;
+  }
+  if (event == Ion::Events::Up || event == Ion::Events::Down) {
+    m_scroll += event == Ion::Events::Up ? 40 : -40;
+    m_scroll = m_scroll < 0 ? 0 : m_scroll;
+    return true;
+  }
+  if (event == Ion::Events::Backspace) {
+    removeLastCodePoint(m_input);
+    return true;
+  }
+  // Typed text: letters with Alpha, digits, operators
+  const char* typed = event.text();
+  if (typed && typed[0] && typed[0] != '\n') {
+    if (strlen(m_input) + strlen(typed) < Engine::k_textSize - 40) {
+      strlcat(m_input, typed, sizeof(m_input));
+    }
+    return true;
+  }
+  return false;
+}
+
+void Controller::send(const char* text) {
+  App::Snapshot* snapshot = App::app()->snapshot();
+  snapshot->addMessage(true, text);
+  m_scroll = 0;
+  // The character types for a moment, like a real person
+  startAnimation();
+  uint64_t start = Ion::Timing::millis();
+  float duration = 650 + Ion::random() % 500;
+  uint64_t previousKeys = Ion::Keyboard::scan();
+  while (true) {
+    float t = frameTime(start);
+    m_typingDots = 1 + ((int)(t / 160) % 3);
+    Ion::Display::waitForVBlank();
+    m_view.render();
+    if (animationsFrozen()) {
+      holdFrozenFrame();
+      break;
+    }
+    uint64_t keys = Ion::Keyboard::scan();
+    if (t >= duration || (keys & ~previousKeys)) {
+      break;
+    }
+    previousKeys = keys;
+  }
+  m_typingDots = 0;
+  char reply[Engine::k_textSize];
+  App::app()->engine()->reply(snapshot->character(), text, snapshot->memory(), reply);
+  snapshot->addMessage(false, reply);
+}
+
+// ---------------------------------------------------------------- Drawing
+
+void Controller::ContentView::drawRect(KDContext* ctx, KDRect rect) const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(rect.intersectedWith(bounds()), absoluteOrigin(), buffer);
+  while (canvas.nextBand()) {
+    if (m_controller->m_mode == Mode::Contacts) {
+      drawContacts(&canvas);
+    } else {
+      drawChat(&canvas);
+    }
+  }
+}
+
+void Controller::ContentView::render() const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(bounds(), absoluteOrigin(), buffer);
+  while (canvas.nextBand()) {
+    if (m_controller->m_mode == Mode::Contacts) {
+      drawContacts(&canvas);
+    } else {
+      drawChat(&canvas);
+    }
+  }
+}
+
+static void drawAvatar(Canvas* canvas, int character, float x, float y, float r) {
+  const Library::Character& who = Engine::character(character);
+  KDColor color = KDColor::RGB24(who.color);
+  canvas->fillCircle(x, y, r, color);
+  char initial[2] = {who.name[0], 0};
+  const Font& font = r > 14 ? k_mediumFont : k_smallFont;
+  canvas->centeredText(initial, font, x, y - font.lineHeight() / 2.0f, KDWhite);
+}
+
+void Controller::ContentView::drawContacts(Canvas* canvas) const {
+  canvas->clear(KDBlack);
+  canvas->text(I18n::translate(I18n::Message::SmsApp), k_titleFont, 14, 4, KDWhite);
+  int n = Library::k_numberOfCharacters;
+  int selected = m_controller->m_selectedContact;
+  // Scroll the list to keep the selection visible
+  constexpr float top = 44;
+  int visible = (int)((k_height - top) / k_rowHeight);
+  int first = selected - visible + 1;
+  first = first < 0 ? 0 : first;
+  for (int i = first; i < n; i++) {
+    float y = top + (i - first) * k_rowHeight;
+    if (!canvas->intersects(y, y + k_rowHeight)) {
+      continue;
+    }
+    if (i == selected) {
+      canvas->fillRoundedRect(8, y + 2, k_width - 16, k_rowHeight - 4, 14, k_cardHighlight);
+    }
+    drawAvatar(canvas, i, 34, y + k_rowHeight / 2, 17);
+    const Library::Character& who = Engine::character(i);
+    canvas->text(who.name, k_mediumFont, 62, y + 6, KDWhite);
+    canvas->text(who.tagline, k_smallFont, 62, y + 26, k_secondaryText);
+  }
+}
+
+namespace {
+struct Layout {
+  int lines;
+  int breaks[k_maxLines + 1];  // Start of each line in the text
+  float width;
+};
+}  // namespace
+
+// Cut a text in lines that fit in a bubble
+static Layout layoutText(const char* text) {
+  Layout layout;
+  layout.lines = 0;
+  layout.width = 0;
+  int length = strlen(text);
+  int start = 0;
+  char line[Engine::k_textSize];
+  while (start < length && layout.lines < k_maxLines) {
+    layout.breaks[layout.lines] = start;
+    int end = length, lastSpace = -1;
+    for (int i = start; i <= length; i++) {
+      if (i == length || text[i] == ' ') {
+        int n = i - start;
+        memcpy(line, text + start, n);
+        line[n] = 0;
+        if (Canvas::textWidth(line, k_smallFont) > k_bubbleMaxWidth - 20 && lastSpace > start) {
+          end = lastSpace;
+          break;
+        }
+        lastSpace = i;
+      }
+    }
+    int n = end - start;
+    memcpy(line, text + start, n);
+    line[n] = 0;
+    float w = Canvas::textWidth(line, k_smallFont);
+    layout.width = w > layout.width ? w : layout.width;
+    layout.lines++;
+    start = end + (end < length ? 1 : 0);
+  }
+  layout.breaks[layout.lines] = length;
+  return layout;
+}
+
+void Controller::ContentView::drawChat(Canvas* canvas) const {
+  App::Snapshot* snapshot = App::app()->snapshot();
+  const Controller* c = m_controller;
+  canvas->clear(KDBlack);
+
+  // Messages, from the latest at the bottom
+  float bottom = k_inputTop - 6 + c->m_scroll;
+  if (c->m_typingDots > 0) {
+    float y = bottom - 26;
+    canvas->fillRoundedRect(10, y, 52, 24, 12, k_theirs);
+    for (int i = 0; i < 3; i++) {
+      bool lit = i == c->m_typingDots - 1;
+      canvas->fillCircle(24 + 12 * i, y + 12, 3.5f, lit ? KDWhite : k_secondaryText);
+    }
+    bottom = y - 6;
+  }
+  char line[Engine::k_textSize];
+  for (int m = snapshot->numberOfMessages() - 1; m >= 0 && bottom > k_headerHeight; m--) {
+    const App::Message& message = snapshot->message(m);
+    Layout layout = layoutText(message.text);
+    float height = layout.lines * k_lineHeight + 12;
+    float width = layout.width + 20;
+    float top = bottom - height;
+    if (canvas->intersects(top, bottom)) {
+      float x = message.mine ? k_width - 10 - width : 10;
+      canvas->fillRoundedRect(x, top, width, height, 12, message.mine ? k_mine : k_theirs);
+      for (int l = 0; l < layout.lines; l++) {
+        int n = layout.breaks[l + 1] - layout.breaks[l];
+        memcpy(line, message.text + layout.breaks[l], n);
+        line[n] = 0;
+        canvas->text(line, k_smallFont, x + 10, top + 6 + l * k_lineHeight, KDWhite);
+      }
+    }
+    bottom = top - 6;
+  }
+
+  // Header, over the messages that scroll under it
+  if (canvas->top() < k_headerHeight) {
+    canvas->fillRect(0, 0, (int)k_width, (int)k_headerHeight, k_bar, 240);
+    int character = snapshot->character();
+    drawAvatar(canvas, character, 22, k_headerHeight / 2, 12);
+    canvas->text(Engine::character(character).name, k_mediumFont, 42, 8, KDWhite);
+  }
+
+  // Input bar
+  if (canvas->bottom() > k_inputTop) {
+    canvas->fillRect(0, (int)k_inputTop - 2, (int)k_width, (int)(k_height - k_inputTop + 2), KDBlack);
+    canvas->fillRoundedRect(8, k_inputTop + 2, k_width - 16, 30, 15, k_bar);
+    float textY = k_inputTop + 2 + (30 - k_smallFont.lineHeight()) / 2.0f;
+    if (c->m_input[0]) {
+      // Show the end of what is being typed
+      const char* shown = c->m_input;
+      while (Canvas::textWidth(shown, k_smallFont) > k_width - 70 && *shown) {
+        shown++;
+        while ((static_cast<uint8_t>(*shown) & 0xC0) == 0x80) shown++;
+      }
+      canvas->text(shown, k_smallFont, 22, textY, KDWhite);
+      float w = Canvas::textWidth(shown, k_smallFont);
+      canvas->fillRect(23 + (int)w, (int)textY + 1, 2, 14, Style::accent());
+    } else {
+      char quick[Engine::k_textSize];
+      App::app()->engine()->quickReply(c->m_quickReply, quick);
+      canvas->text("«", k_smallFont, 18, textY, k_secondaryText);
+      canvas->centeredText(quick, k_smallFont, k_width / 2 - 12, textY, KDColor::RGB24(0xC7C7CC));
+      canvas->text("»", k_smallFont, k_width - 60, textY, k_secondaryText);
+    }
+    // Send button
+    canvas->fillCircle(k_width - 26, k_inputTop + 17, 11, k_mine);
+    canvas->fillTriangle(k_width - 31, k_inputTop + 18, k_width - 26, k_inputTop + 11, k_width - 21, k_inputTop + 18, KDWhite);
+    canvas->fillRect((int)k_width - 27, (int)k_inputTop + 16, 3, 8, KDWhite);
+  }
+}
+
+}  // namespace Sms
