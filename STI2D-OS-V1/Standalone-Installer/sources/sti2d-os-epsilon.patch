diff --git a/epsilon/apps/sti2d/style.cpp b/epsilon/apps/sti2d/style.cpp
new file mode 100644
index 0000000..81cc909
--- /dev/null
+++ b/epsilon/apps/sti2d/style.cpp
@@ -0,0 +1,205 @@
+#include "style.h"
+
+#include "theme.h"
+
+#if !PLATFORM_DEVICE
+#include <stdio.h>
+#include <stdlib.h>
+#endif
+
+namespace STI2D {
+namespace Style {
+
+/* The installer looks for this magic in the firmware and fills the fields
+ * after it. */
+struct InstallerConfig {
+  char magic[12];
+  uint32_t wallpaperAddress;  // 0 if none
+  uint32_t wallpaperSize;
+  uint16_t backgroundColor;  // RGB565
+  uint16_t reserved;
+};
+__attribute__((used)) volatile const InstallerConfig k_installerConfig = {
+    {'S', 'T', 'I', '2', 'D', 'O', 'S', 'C', 'O', 'N', 'F', '!'}, 0, 0, 0, 0};
+
+static Face s_face = Face::Digital;
+static Theme s_theme = Theme::Classic;
+static int s_accent = 0;
+static int s_backgroundColor = 0;
+static bool s_initialized = false;
+static Background s_background = Background::Color;
+
+static void init() {
+  if (s_initialized) {
+    return;
+  }
+  s_initialized = true;
+  s_background = hasWallpaper() ? Background::Wallpaper : Background::Color;
+}
+
+Face face() { return s_face; }
+void setFace(Face face) { s_face = face; }
+Theme theme() { return s_theme; }
+void setTheme(Theme theme) { s_theme = theme; }
+int accentIndex() { return s_accent; }
+void setAccentIndex(int index) { s_accent = index; }
+
+constexpr static KDColor k_accents[k_numberOfAccents] = {
+    KDColor::RGB24(0xFF9F0A),  // Orange
+    KDColor::RGB24(0xFF453A),  // Red
+    KDColor::RGB24(0xFF375F),  // Pink
+    KDColor::RGB24(0xBF5AF2),  // Purple
+    KDColor::RGB24(0x5E5CE6),  // Indigo
+    KDColor::RGB24(0x0A84FF),  // Blue
+    KDColor::RGB24(0x64D2FF),  // Cyan
+    KDColor::RGB24(0x30D158),  // Green
+    KDColor::RGB24(0xFFD60A),  // Yellow
+    KDColor::RGB24(0xFFFFFF),  // White
+};
+
+KDColor accentAt(int index) { return k_accents[index]; }
+
+KDColor accent() {
+  if (s_accent != 0) {
+    return k_accents[s_accent];
+  }
+  // The default accent follows the theme
+  switch (s_theme) {
+    case Theme::Halloween:
+      return KDColor::RGB24(0xFF7A00);
+    case Theme::Christmas:
+      return KDColor::RGB24(0xFF3B30);
+    case Theme::Mario:
+      return KDColor::RGB24(0xFCD000);
+    case Theme::Minecraft:
+      return KDColor::RGB24(0x7CD34A);
+    case Theme::ViceCity:
+      return KDColor::RGB24(0xFF4FD8);
+    case Theme::Manga:
+      return KDColor::RGB24(0xE60012);
+    case Theme::Space:
+      return KDColor::RGB24(0x9D8CFF);
+    default:
+      return k_accents[0];
+  }
+}
+
+static uintptr_t wallpaperAddress() {
+#if !PLATFORM_DEVICE
+  /* The simulator loads the wallpaper made by the installer from the file in
+   * STI2D_WALLPAPER, for screenshots. */
+  static uint8_t* s_simulatorWallpaper = nullptr;
+  const char* path = getenv("STI2D_WALLPAPER");
+  if (path && !s_simulatorWallpaper) {
+    FILE* f = fopen(path, "rb");
+    if (f) {
+      s_simulatorWallpaper = static_cast<uint8_t*>(malloc(320 * 240 * 2 + 4096));
+      fread(s_simulatorWallpaper, 1, 320 * 240 * 2 + 4096, f);
+      fclose(f);
+    }
+  }
+  if (s_simulatorWallpaper) {
+    return reinterpret_cast<uintptr_t>(s_simulatorWallpaper);
+  }
+#endif
+  return k_installerConfig.wallpaperAddress;
+}
+
+bool hasWallpaper() {
+  uintptr_t address = wallpaperAddress();
+  if (address == 0) {
+    return false;
+  }
+  const uint8_t* data = reinterpret_cast<const uint8_t*>(address);
+  return data[0] == 'S' && data[1] == 'T' && data[2] == 'W' && data[3] == 'P';
+}
+
+Background background() {
+  init();
+  return s_background;
+}
+
+void setBackground(Background background) {
+  init();
+  s_background =
+      background == Background::Wallpaper && !hasWallpaper() ? Background::Color
+                                                             : background;
+}
+
+int backgroundColorIndex() { return s_backgroundColor; }
+void setBackgroundColorIndex(int index) { s_backgroundColor = index; }
+
+constexpr static KDColor k_backgroundColors[k_numberOfBackgroundColors] = {
+    KDBlack,                   // Replaced by the installer's color
+    KDColor::RGB24(0x1C1C1E),  // Graphite
+    KDColor::RGB24(0x0B1A3A),  // Midnight blue
+    KDColor::RGB24(0x2A0B3D),  // Plum
