diff --git a/epsilon/apps/sms/app.cpp b/epsilon/apps/sms/app.cpp
new file mode 100644
index 0000000..f23271a
--- /dev/null
+++ b/epsilon/apps/sms/app.cpp
@@ -0,0 +1,51 @@
+#include "app.h"
+
+#include <apps/i18n.h>
+#include <apps/icons/sms_icon.h>
+#include <string.h>
+
+namespace Sms {
+
+I18n::Message App::Descriptor::name() const { return I18n::Message::SmsApp; }
+
+I18n::Message App::Descriptor::upperName() const {
+  return I18n::Message::SmsAppCapital;
+}
+
+Escher::ThemedImage App::Descriptor::icon() const {
+  return *ImageStore::SmsIcon;
+}
+
+App* App::Snapshot::unpack(Escher::Container* container) {
+  return new (container->currentAppBuffer()) App(this);
+}
+
+const App::Descriptor* App::Snapshot::descriptor() const {
+  constexpr static Descriptor s_descriptor;
+  return &s_descriptor;
+}
+
+void App::Snapshot::setCharacter(int character) {
+  if (character != m_character) {
+    // A new conversation, but the user's name is remembered
+    m_character = character;
+    m_numberOfMessages = 0;
+  }
+}
+
+void App::Snapshot::addMessage(bool mine, const char* text) {
+  if (m_numberOfMessages == k_maxNumberOfMessages) {
+    memmove(m_messages, m_messages + 1, sizeof(Message) * (k_maxNumberOfMessages - 1));
+    m_numberOfMessages--;
+  }
+  m_messages[m_numberOfMessages].mine = mine;
+  strlcpy(m_messages[m_numberOfMessages].text, text, Engine::k_textSize);
+  m_numberOfMessages++;
+}
+
+App::App(Snapshot* snapshot)
+    : Escher::App(snapshot, &m_controller),
+      m_engine(m_blockBuffer),
+      m_controller(&m_modalViewController) {}
+
+}  // namespace Sms
diff --git a/epsilon/apps/sms/app.h b/epsilon/apps/sms/app.h
new file mode 100644
