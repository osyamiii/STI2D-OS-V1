diff --git a/tools/sti2d/dfu_elements.py b/tools/sti2d/dfu_elements.py
new file mode 100644
index 0000000..bf4acad
--- /dev/null
+++ b/tools/sti2d/dfu_elements.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""Read the elements (address, data) of a DfuSe file."""
+import struct
+import sys
+
+def read_dfu(path):
+    data = open(path, "rb").read()
+    assert data[:5] == b"DfuSe", "not a DfuSe file"
+    targets = data[10]
+    offset = 11
+    elements = []
+    for _ in range(targets):
+        assert data[offset:offset + 6] == b"Target"
+        n_elements = struct.unpack("<I", data[offset + 270:offset + 274])[0]
+        offset += 274
+        for _ in range(n_elements):
+            addr, size = struct.unpack("<II", data[offset:offset + 8])
+            elements.append((addr, data[offset + 8:offset + 8 + size]))
+            offset += 8 + size
+    return elements
+
+if __name__ == "__main__":
+    for addr, payload in read_dfu(sys.argv[1]):
+        print(f"0x{addr:08x} {len(payload)}")
