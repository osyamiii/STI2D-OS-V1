@@ -0,0 +1,223 @@
+#include "date_time_controller.h"
+
+#include <apps/i18n.h>
+
+#include <cmath>
+
+#include "theme.h"
+
+namespace STI2D {
+
+DateTimeController::DateTimeController(Escher::Responder* parentResponder)
+    : ViewController(parentResponder),
+      m_view(this),
+      m_row(Row::Zone),
+      m_editing(false),
+      m_field(0),
+      m_edited(Clock::now()) {}
+
+const char* DateTimeController::title() const {
+  return I18n::translate(I18n::Message::DateTime);
+}
+
+void DateTimeController::viewWillAppear() {
+  ViewController::viewWillAppear();
+  m_row = Row::Zone;
+  m_editing = false;
+  m_view.reload();
+}
+
+int DateTimeController::numberOfFields() const {
+  return m_row == Row::Time ? 2 : 3;
+}
+
+void DateTimeController::changeField(int delta) {
+  Clock::DateTime& d = m_edited;
+  auto wrap = [](int value, int min, int max) {
+    int range = max - min + 1;
+    return min + ((value - min) % range + range) % range;
+  };
+  if (m_row == Row::Time) {
+    if (m_field == 0) {
+      d.hour = wrap(d.hour + delta, 0, 23);
+    } else {
+      d.minute = wrap(d.minute + delta, 0, 59);
+    }
+    return;
+  }
+  if (m_field == 0) {
+    d.day = wrap(d.day + delta, 1, Clock::daysInMonth(d.year, d.month));
+  } else if (m_field == 1) {
+    d.month = wrap(d.month + delta, 1, 12);
+  } else {
+    d.year = wrap(d.year + delta, 2024, 2099);
+  }
+  int maxDay = Clock::daysInMonth(d.year, d.month);
+  if (d.day > maxDay) {
+    d.day = maxDay;
+  }
+}
+
+bool DateTimeController::handleEvent(Ion::Events::Event event) {
+  if (m_editing) {
+    if (event == Ion::Events::Left || event == Ion::Events::Right) {
+      int n = numberOfFields();
+      m_field = (m_field + (event == Ion::Events::Right ? 1 : n - 1)) % n;
+    } else if (event == Ion::Events::Up || event == Ion::Events::Down) {
+      changeField(event == Ion::Events::Up ? 1 : -1);
+    } else if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+      m_edited.second = 0;
+      Clock::setLocalTime(m_edited);
+      m_editing = false;
+    } else if (event == Ion::Events::Back) {
+      m_editing = false;
+    } else {
+      return false;
+    }
+    m_view.reload();
+    return true;
+  }
+  if (event == Ion::Events::Up || event == Ion::Events::Down) {
+    int row = static_cast<int>(m_row) + (event == Ion::Events::Down ? 1 : -1);
+    if (row < 0 || row >= k_numberOfRows) {
+      return false;
+    }
+    m_row = static_cast<Row>(row);
+  } else if (m_row == Row::Zone &&
+             (event == Ion::Events::Left || event == Ion::Events::Right ||
+              event == Ion::Events::OK || event == Ion::Events::EXE)) {
+    int zone = static_cast<int>(Clock::zone()) +
+               (event == Ion::Events::Left ? Clock::k_numberOfZones - 1 : 1);
+    Clock::setZone(static_cast<Clock::Zone>(zone % Clock::k_numberOfZones));
+  } else if (m_row != Row::Zone &&
+             (event == Ion::Events::OK || event == Ion::Events::EXE)) {
+    m_editing = true;
+    m_field = 0;
+    m_edited = Clock::now();
+  } else {
+    return false;
+  }
+  m_view.reload();
+  return true;
+}
+
+static void twoDigits(char* buffer, int value) {
+  buffer[0] = '0' + (value / 10) % 10;
+  buffer[1] = '0' + value % 10;
+  buffer[2] = 0;
+}
+
+void DateTimeController::ContentView::drawRect(KDContext* ctx,
+                                               KDRect rect) const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(rect.intersectedWith(bounds()), absoluteOrigin(), buffer);
+  while (canvas.nextBand()) {
+    drawScene(&canvas);
+  }
+}
+
+void DateTimeController::ContentView::drawScene(Canvas* canvas) const {
+  const DateTimeController* c = m_controller;
+  float width = bounds().width();
+  float cx = width / 2.0f;
+  canvas->clear(KDBlack);
+
+  // Current time
+  Clock::DateTime now = Clock::now();
+  char time[6];
+  twoDigits(time, now.hour);
+  time[2] = ':';
+  twoDigits(time + 3, now.minute);
+  canvas->centeredText(time, k_titleFont, cx, 6.0f, KDWhite);
+
+  // Rows
+  constexpr float rowHeight = 36.0f;
+  constexpr float rowGap = 5.0f;
+  constexpr float top = 46.0f;
+  constexpr float margin = 10.0f;
+  Clock::DateTime shown = c->m_editing ? c->m_edited : now;
+  for (int i = 0; i < k_numberOfRows; i++) {
+    float y = top + i * (rowHeight + rowGap);
+    if (!canvas->intersects(y, y + rowHeight)) {
+      continue;
+    }
+    bool selected = static_cast<int>(c->m_row) == i;
+    canvas->fillRoundedRect(margin, y, width - 2 * margin, rowHeight, 10.0f,
+                            selected ? k_cardHighlight : k_cardBackground);
+    if (selected) {
+      canvas->fillRoundedRect(margin, y + 8.0f, 4.0f, rowHeight - 16.0f, 2.0f,
+                              k_accent);
+    }
+    float textY = y + (rowHeight - k_mediumFont.lineHeight()) / 2.0f;
+    constexpr I18n::Message labels[] = {I18n::Message::TimeZone,
+                                        I18n::Message::Time,
+                                        I18n::Message::Date};
+    canvas->text(I18n::translate(labels[i]), k_mediumFont, margin + 14.0f,
+                 textY, KDWhite);
+    float right = width - margin - 14.0f;
+    if (i == 0) {
+      char offset[12];
+      Clock::zoneOffsetText(Clock::zone(), offset, sizeof(offset));
+      const char* name = I18n::translate(Clock::zoneName(Clock::zone()));
+      float offsetWidth = Canvas::textWidth(offset, k_smallFont);
+      canvas->text(offset, k_smallFont, right - offsetWidth,
+                   y + (rowHeight - k_smallFont.lineHeight()) / 2.0f,
+                   k_secondaryText);
+      float nameWidth = Canvas::textWidth(name, k_mediumFont);
+      canvas->text(name, k_mediumFont, right - offsetWidth - 8.0f - nameWidth,
+                   textY, k_accent);
+      continue;
+    }
+    // Fields, right aligned: HH : MM or DD / MM / YYYY
+    char fields[3][5];
+    int numberOfFields = i == 1 ? 2 : 3;
+    if (i == 1) {
+      twoDigits(fields[0], shown.hour);
+      twoDigits(fields[1], shown.minute);
+    } else {
+      twoDigits(fields[0], shown.day);
+      twoDigits(fields[1], shown.month);
+      fields[2][0] = '0' + (shown.year / 1000) % 10;
+      fields[2][1] = '0' + (shown.year / 100) % 10;
+      fields[2][2] = '0' + (shown.year / 10) % 10;
+      fields[2][3] = '0' + shown.year % 10;
+      fields[2][4] = 0;
+    }
+    const char* separator = i == 1 ? ":" : "/";
+    float separatorWidth = Canvas::textWidth(separator, k_mediumFont) + 8.0f;
+    float total = -separatorWidth;
+    float widths[3];
+    for (int f = 0; f < numberOfFields; f++) {
+      widths[f] = Canvas::textWidth(fields[f], k_mediumFont) + 10.0f;
+      total += widths[f] + separatorWidth;
+    }
+    float x = right - total;
+    bool editingRow = c->m_editing && selected;
+    for (int f = 0; f < numberOfFields; f++) {
+      bool active = editingRow && c->m_field == f;
+      if (active) {
+        canvas->fillRoundedRect(x, y + 6.0f, widths[f], rowHeight - 12.0f,
+                                7.0f, k_accent);
+      }
+      canvas->text(fields[f], k_mediumFont, roundFloat(x + 5.0f), textY,
+                   active ? KDBlack
+                          : (editingRow ? KDWhite : k_accent));
+      x += widths[f];
+      if (f < numberOfFields - 1) {
+        canvas->text(separator, k_mediumFont, roundFloat(x + 4.0f), textY,
+                     k_secondaryText);
+        x += separatorWidth;
+      }
+    }
+  }
+
+  // Help
+  I18n::Message help = c->m_editing ? I18n::Message::DateTimeHelpEdit
+                       : c->m_row == Row::Zone
+                           ? I18n::Message::DateTimeHelpZone
+                           : I18n::Message::DateTimeHelpBrowse;
+  canvas->centeredText(I18n::translate(help), k_smallFont, cx,
+                       top + 3 * (rowHeight + rowGap) + 4.0f, k_secondaryText);
+}
+
+}  // namespace STI2D
