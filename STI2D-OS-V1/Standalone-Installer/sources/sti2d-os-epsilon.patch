+    KDColor::RGB24(0x3A0A0A),  // Burgundy
+    KDColor::RGB24(0x2B2112),  // Coffee
+    KDColor::RGB24(0x002B36),  // Ocean
+};
+
+KDColor backgroundColorAt(int index) {
+  if (index == 0) {
+    return KDColor::RGB16(k_installerConfig.backgroundColor);
+  }
+  return k_backgroundColors[index];
+}
+
+void drawBackground(Canvas* canvas, int dim) {
+  if (background() == Background::Wallpaper) {
+    canvas->wallpaper(reinterpret_cast<const uint8_t*>(wallpaperAddress()),
+                      dim);
+  } else {
+    canvas->clear(backgroundColorAt(s_backgroundColor));
+  }
+}
+
+bool lightBackground() {
+  if (background() == Background::Wallpaper) {
+    return false;
+  }
+  uint16_t c = backgroundColorAt(s_backgroundColor);
+  int luminance = ((c >> 11) << 3) * 3 + (((c >> 5) & 0x3F) << 2) * 6 +
+                  ((c & 0x1F) << 3);
+  return luminance > 1400;
+}
