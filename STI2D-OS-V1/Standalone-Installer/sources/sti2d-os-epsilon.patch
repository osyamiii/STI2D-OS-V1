diff --git a/epsilon/apps/sti2d/face.cpp b/epsilon/apps/sti2d/face.cpp
new file mode 100644
index 0000000..335d7f8
--- /dev/null
+++ b/epsilon/apps/sti2d/face.cpp
@@ -0,0 +1,442 @@
+#include "face.h"
+
+#include <apps/i18n.h>
+#include <ion.h>
+
+#include <cmath>
+
+#include "clock.h"
+#include "style.h"
+#include "theme.h"
+
+namespace STI2D {
+
+using Style::Theme;
+
+constexpr static float k_width = Ion::Display::Width;
+constexpr static float k_height = Ion::Display::Height;
+constexpr static float k_twoPi = 6.2831853f;
+
+FaceData currentFaceData() {
+  Clock::DateTime now = Clock::now();
+  float voltage = Ion::Battery::voltage();
+  int battery = (int)((voltage - 3.6f) / (4.15f - 3.6f) * 100.0f + 0.5f);
+  battery = battery < 0 ? 0 : (battery > 100 ? 100 : battery);
+  return {now.hour,    now.minute, now.day,
+          now.month,   now.weekDay, battery,
+          Ion::Battery::isCharging(), Clock::isSet()};
+}
+
+// Deterministic noise, for stars, snow and blocks
+static uint32_t hash(uint32_t x) {
+  x ^= x >> 16;
+  x *= 0x7feb352d;
+  x ^= x >> 15;
+  x *= 0x846ca68b;
+  x ^= x >> 16;
+  return x;
+}
+static float random01(uint32_t seed) { return (hash(seed) & 0xFFFF) / 65535.0f; }
+
+static KDColor rgb(uint32_t c) { return KDColor::RGB24(c); }
+
+// ---------------------------------------------------------------- Sceneries
+
+static void drawHalloween(Canvas* c, int a) {
+  c->verticalGradient(0, (int)k_height, rgb(0x1A0B2E), rgb(0x3D1A00));
+  // Moon and bats
+  c->glow(268, 44, 22, 22, rgb(0xFFF3C4), a / 5);
+  c->fillCircle(268, 44, 22, rgb(0xFFF3C4), a);
+  c->fillCircle(258, 38, 20, rgb(0x1E0E2C), a);
+  for (int i = 0; i < 3; i++) {
+    float x = 210 + 28 * i, y = 30 + 14 * (i % 2);
+    c->fillTriangle(x - 9, y - 3, x, y + 2, x - 3, y + 5, KDBlack, a);
+    c->fillTriangle(x + 9, y - 3, x, y + 2, x + 3, y + 5, KDBlack, a);
+    c->fillCircle(x, y + 2, 2.5f, KDBlack, a);
+  }
+  // Pumpkin
+  constexpr float px = 30, py = 156;
+  c->capsule(px, py - 26, px + 4, py - 34, 3, rgb(0x3E7D2A), a);
+  c->fillCircle(px - 13, py, 19, rgb(0xE8650A), a);
+  c->fillCircle(px + 13, py, 19, rgb(0xE8650A), a);
+  c->fillCircle(px, py, 22, rgb(0xFF7A12), a);
+  c->fillTriangle(px - 13, py - 6, px - 4, py - 6, px - 8, py - 14, rgb(0xFFD23F), a);
+  c->fillTriangle(px + 13, py - 6, px + 4, py - 6, px + 8, py - 14, rgb(0xFFD23F), a);
+  c->fillTriangle(px - 12, py + 6, px + 12, py + 6, px, py + 13, rgb(0xFFD23F), a);
+}
+
+static void drawChristmas(Canvas* c, int a) {
+  c->verticalGradient(0, (int)k_height, rgb(0x0B2A4A), rgb(0x123D2E));
+  // Snow on the ground
+  c->fillRoundedRect(-20, 214, k_width + 40, 60, 24, rgb(0xEAF4FF), a);
+  // Tree
+  constexpr float tx = 300;
+  c->fillRect((int)tx - 4, 166, 8, 12, rgb(0x6B3E1E), a);
+  for (int i = 0; i < 3; i++) {
+    float top = 110 + 16 * i, half = 13 + 5 * i;
+    c->fillTriangle(tx, top, tx - half, top + 26, tx + half, top + 26, rgb(0x1F8A4C), a);
+  }
+  c->fillCircle(tx, 110, 4, rgb(0xFFD60A), a);
+  constexpr float balls[6][2] = {{-7, 132}, {8, 140}, {-12, 156}, {5, 158}, {14, 162}, {-2, 146}};
+  for (int i = 0; i < 6; i++) {
+    c->fillCircle(tx + balls[i][0], balls[i][1], 2.5f, i % 2 ? rgb(0xFF3B30) : rgb(0xFFD60A), a);
+  }
+  // Snowflakes
+  for (int i = 0; i < 70; i++) {
+    float x = random01(i * 3 + 1) * k_width, y = random01(i * 3 + 2) * 210;
+    c->fillCircle(x, y, 0.8f + 1.4f * random01(i * 3 + 3), KDWhite, a * 3 / 4);
+  }
+}
+
+static void drawMario(Canvas* c, int a) {
+  c->clear(rgb(0x5C94FC));
+  // Clouds
+  constexpr float clouds[2][2] = {{60, 40}, {250, 70}};
+  for (int i = 0; i < 2; i++) {
+    float x = clouds[i][0], y = clouds[i][1];
+    c->fillCircle(x - 14, y + 4, 11, KDWhite, a);
+    c->fillCircle(x, y, 15, KDWhite, a);
+    c->fillCircle(x + 15, y + 4, 11, KDWhite, a);
+  }
+  // Pipe
+  c->fillRect(296, 158, 30, 62, rgb(0x00A800), a);
+  c->fillRect(291, 146, 40, 14, rgb(0x00C800), a);
+  c->fillRect(300, 160, 5, 60, rgb(0x80F080), a);
+  // Question block and coin
+  c->fillRect(30, 128, 24, 24, rgb(0xFC9838), a);
+  c->text("?", k_mediumFont, 37, 131, rgb(0x7C3000), a);
+  c->fillRoundedRect(37, 104, 10, 16, 5, rgb(0xFCD000), a);
+  // Bricks
+  for (int row = 0; row < 2; row++) {
+    int y = 220 + 10 * row;
+    c->fillRect(0, y, (int)k_width, 10, rgb(0xC84C0C), a);
+    c->fillRect(0, y, (int)k_width, 1, rgb(0x000000), a);
+    for (int x = (row % 2) * 10; x < k_width; x += 20) {
+      c->fillRect(x, y, 1, 10, rgb(0x000000), a);
+    }
+  }
+}
+
+static void drawMinecraft(Canvas* c, int a) {
+  c->verticalGradient(0, 200, rgb(0x6FB1F0), rgb(0xA9D6FF));
+  // Square sun
+  c->fillRect(250, 26, 30, 30, rgb(0xFFF59D), a);
+  c->fillRect(254, 30, 22, 22, rgb(0xFFFDE7), a);
+  // Blocky tree
+  for (int y = 128; y < 196; y += 8) {
+    c->fillRect(300, y, 8, 8, rgb(0x6B4F2A), a);
+  }
+  for (int i = 0; i < 16; i++) {
+    int bx = 280 + 8 * (i % 6), by = 100 + 8 * (i / 6);
+    c->fillRect(bx, by, 8, 8, random01(i + 50) > 0.5f ? rgb(0x3E8E2F) : rgb(0x4CA63A), a);
+  }
+  // Grass and dirt blocks, with pixel noise
+  constexpr int block = 4;
+  for (int y = 196; y < (int)k_height; y += block) {
+    if (!c->intersects(y, y + block)) {
+      continue;
+    }
+    for (int x = 0; x < (int)k_width; x += block) {
+      float n = random01(x * 977 + y * 131);
+      KDColor color;
+      if (y < 204) {
+        color = n > 0.5f ? rgb(0x5DAA3A) : rgb(0x6BBF45);
+      } else if (y < 208 && n > 0.6f) {
+        color = rgb(0x5DAA3A);
+      } else {
+        color = n > 0.66f ? rgb(0x8B6A47) : (n > 0.33f ? rgb(0x79583A) : rgb(0x6B4B2E));
+      }
+      c->fillRect(x, y, block, block, color, a);
+    }
+  }
+}
+
+static void drawViceCity(Canvas* c, int a) {
+  constexpr int horizon = 160;
+  c->verticalGradient(0, horizon, rgb(0x2B0B3F), rgb(0xFF5E9C));
+  c->verticalGradient(horizon, (int)k_height, rgb(0x1A0626), rgb(0x0B0213));
+  // Striped sun
+  constexpr float sx = 160, sy = 150, r = 52;
+  for (int y = (int)(sy - r); y < horizon; y++) {
+    if (!c->intersects(y, y + 1)) {
+      continue;
+    }
+    float t = (y - (sy - r)) / (2 * r);
+    bool gap = y > sy - 18 && (y % 7) < 2 + (int)((y - (sy - 18)) / 9);
+    if (gap) {
+      continue;
+    }
+    float dy = y + 0.5f - sy;
+    float h = std::sqrt(maxFloat(r * r - dy * dy, 0.0f));
+    c->fillRect((int)(sx - h), y, (int)(2 * h), 1, Canvas::mix(rgb(0xFFE66D), rgb(0xFF3CAC), (int)(t * 256)), a);
+  }
+  // Perspective grid
+  for (int i = 0; i < 6; i++) {
+    float t = (i + 1) / 6.0f;
+    int y = horizon + (int)(t * t * (k_height - horizon));
+    c->fillRect(0, y, (int)k_width, 1, rgb(0xFF3CAC), a * 3 / 4);
+  }
+  for (int i = -8; i <= 8; i++) {
+    c->capsule(160 + i * 12, horizon, 160 + i * 60, k_height, 0.5f, rgb(0xFF3CAC), a * 3 / 4);
+  }
+  // Palm trees
+  constexpr float palms[2][2] = {{10, 1}, {310, -1}};
+  for (int i = 0; i < 2; i++) {
+    float x = palms[i][0], lean = palms[i][1];
+    c->capsule(x, 200, x + 10 * lean, 96, 3, KDBlack, a);
+    for (int k = 0; k < 5; k++) {
+      float angle = -2.6f + 0.55f * k;
+      c->capsule(x + 10 * lean, 96, x + 10 * lean + 30 * std::cos(angle), 96 + 18 * std::sin(angle) + 12, 2.5f, KDBlack, a);
+    }
+  }
+}
+
+static void drawManga(Canvas* c, int a) {
+  c->clear(rgb(0xFBF7EE));
+  // Speed lines from the center
+  for (int i = 0; i < 48; i++) {
+    float angle = k_twoPi * (i + 0.5f * random01(i)) / 48.0f;
+    float inner = 92 + 30 * random01(i + 100);
+    float cx = 160 + inner * std::cos(angle), cy = 112 + inner * 0.72f * std::sin(angle);
+    float ox = 160 + 260 * std::cos(angle), oy = 112 + 190 * std::sin(angle);
+    c->capsule(cx, cy, ox, oy, 0.6f + 1.4f * random01(i + 200), KDBlack, a);
+  }
+  // Halftone dots in the corners
+  for (int y = 6; y < k_height; y += 9) {
+    for (int x = 6; x < k_width; x += 9) {
+      float d = std::sqrt((x - 160.0f) * (x - 160.0f) + (y - 112.0f) * (y - 112.0f) * 1.6f);
+      float r = (d - 150) / 40.0f;
+      if (r > 0.1f) {
+        c->fillCircle(x, y, minFloat(r, 3.5f), rgb(0x9A9A9A), a);
+      }
+    }
+  }
+}
+
+static void drawSpace(Canvas* c, int a) {
+  c->verticalGradient(0, (int)k_height, rgb(0x050816), rgb(0x1A1040));
+  for (int i = 0; i < 90; i++) {
+    float x = random01(i * 5 + 7) * k_width, y = random01(i * 5 + 8) * k_height;
+    float s = random01(i * 5 + 9);
+    c->fillCircle(x, y, 0.5f + 1.2f * s, KDWhite, (int)(a * (0.4f + 0.6f * s)));
+  }
+  // Ringed planet
+  constexpr float px = 34, py = 40;
+  c->glow(px, py, 20, 14, rgb(0x9D8CFF), a / 4);
+  c->fillCircle(px, py, 20, rgb(0x7B5CFF), a);
+  c->fillCircle(px - 6, py - 6, 13, rgb(0x9D8CFF), a / 2);
+  c->capsule(px - 34, py + 7, px + 34, py - 7, 1.8f, rgb(0xE0D8FF), a);
+}
+
+static void drawScenery(Canvas* c, int a) {
+  switch (Style::theme()) {
+    case Theme::Halloween:
+      return drawHalloween(c, a);
+    case Theme::Christmas:
+      return drawChristmas(c, a);
+    case Theme::Mario:
+      return drawMario(c, a);
+    case Theme::Minecraft:
+      return drawMinecraft(c, a);
+    case Theme::ViceCity:
+      return drawViceCity(c, a);
+    case Theme::Manga:
+      return drawManga(c, a);
+    case Theme::Space:
+      return drawSpace(c, a);
+    default:
+      return;
+  }
+}
+
+/* The gradients and clears of the sceneries above ignore alpha: when the face
+ * fades, the scenery is drawn in an intermediate step. */
+
+static bool darkText() {
+  Theme t = Style::theme();
+  return t == Theme::Manga || (t == Theme::Classic && Style::lightBackground());
+}
+
+// ---------------------------------------------------------------- Faces
+
+static void twoDigits(char* buffer, int value) {
+  buffer[0] = '0' + (value / 10) % 10;
+  buffer[1] = '0' + value % 10;
+}
+
+static void formatDate(char* date, const FaceData& d) {
+  const char* day = I18n::translate((I18n::Message)((int)I18n::Message::STI2DDay0 + d.weekDay));
+  const char* month = I18n::translate((I18n::Message)((int)I18n::Message::STI2DMonth00 + d.month - 1));
+  int n = 0;
+  for (const char* c = day; *c && n < 16; c++) {
+    date[n++] = *c;
+  }
+  date[n++] = ' ';
+  if (d.day >= 10) {
+    date[n++] = '0' + d.day / 10;
+  }
+  date[n++] = '0' + d.day % 10;
+  date[n++] = ' ';
+  for (const char* c = month; *c && n < 38; c++) {
+    date[n++] = *c;
+  }
+  date[n] = 0;
+}
+
+static void drawTimeText(Canvas* c, const FaceData& d, const Font& font, float cx, float y, KDColor color, int a) {
+  char time[6] = "--:--";
+  if (d.clockIsSet) {
+    twoDigits(time, d.hour);
+    twoDigits(time + 3, d.minute);
+  }
+  if (Style::theme() == Theme::Mario || Style::theme() == Theme::Minecraft) {
+    // A hard shadow, like in the games
+    c->centeredText(time, font, cx + 3, y + 3, KDBlack, a / 2);
+  }
+  c->centeredText(time, font, cx, y, color, a);
+}
+
+static void drawBattery(Canvas* c, const FaceData& d, float x, float y, float r, KDColor text, int a) {
+  KDColor color = (d.battery < 20 && !d.charging) ? k_red : k_green;
+  c->arc(x, y, r, r / 4, 0.0f, 1.0f, color, a / 4);
+  c->arc(x, y, r, r / 4, 0.0f, d.battery / 100.0f * 0.999f, color, a);
+  char percent[5];
+  int p = 0;
+  if (d.battery >= 100) {
+    percent[p++] = '1';
+  }
+  if (d.battery >= 10) {
+    percent[p++] = '0' + (d.battery / 10) % 10;
+  }
+  percent[p++] = '0' + d.battery % 10;
+  percent[p] = 0;
+  c->centeredText(percent, k_smallFont, x, y - 8, text, a);
+}
+
+static void drawRings(Canvas* c, float x, float y, float r, int a) {
+  constexpr float sweeps[3] = {0.82f, 0.64f, 0.9f};
+  float thickness = r / 4;
+  for (int i = 0; i < 3; i++) {
+    float ri = r - (thickness + 1) * i;
+    c->arc(x, y, ri, thickness, 0.0f, 1.0f, k_ringColors[i], a / 5);
+    c->arc(x, y, ri, thickness, 0.0f, sweeps[i], k_ringColors[i], a);
+  }
+}
+
+static void drawHands(Canvas* c, const FaceData& d, float cx, float cy, float r, KDColor color, KDColor accent, int a, bool thick) {
+  float minuteAngle = k_twoPi * d.minute / 60.0f;
+  float hourAngle = k_twoPi * ((d.hour % 12) + d.minute / 60.0f) / 12.0f;
+  float hr = r * 0.52f, mr = r * 0.82f;
+  c->capsule(cx, cy, cx + hr * std::sin(hourAngle), cy - hr * std::cos(hourAngle), thick ? 4.5f : 3.5f, color, a);
+  c->capsule(cx, cy, cx + mr * std::sin(minuteAngle), cy - mr * std::cos(minuteAngle), thick ? 3.0f : 2.2f, color, a);
+  c->fillCircle(cx, cy, 6, accent, a);
+  c->fillCircle(cx, cy, 2.5f, darkText() ? KDWhite : KDBlack, a);
+}
+
+static void drawDigital(Canvas* c, const FaceData& d, KDColor text, KDColor secondary, KDColor accent, int a) {
+  constexpr float cx = k_width / 2;
+  char date[40];
+  formatDate(date, d);
+  c->centeredText(date, k_mediumFont, cx, 26, accent, a);
+  drawTimeText(c, d, k_clockFont, cx, 44, text, a);
+  constexpr float y = 200;
+  drawBattery(c, d, 50, y, 19, text, a);
+  drawRings(c, k_width - 50, y, 19, a);
+  c->centeredText("STI2D OS", k_mediumFont, cx, y - 18, text, a);
+  c->centeredText(I18n::translate(I18n::Message::STI2DFaceHint), k_smallFont, cx, y + 2, secondary, a);
+}
+
+static void drawAnalog(Canvas* c, const FaceData& d, KDColor text, KDColor secondary, KDColor accent, int a, bool numbers) {
+  constexpr float cx = k_width / 2, cy = 120, r = 100;
+  for (int i = 0; i < 60; i++) {
+    float angle = k_twoPi * i / 60.0f;
+    bool hour = i % 5 == 0;
+    float r0 = hour ? r - (numbers ? 8 : 16) : r - 4;
+    if (!numbers && !hour) {
+      continue;
+    }
+    c->capsule(cx + r0 * std::sin(angle), cy - r0 * std::cos(angle), cx + r * std::sin(angle), cy - r * std::cos(angle),
+               hour ? (numbers ? 1.2f : 2.6f) : 0.6f, i == 0 && !numbers ? accent : (hour ? text : secondary), a);
+  }
+  if (numbers) {
+    for (int h = 1; h <= 12; h++) {
+      float angle = k_twoPi * h / 12.0f;
+      float rr = r - 24;
+      char label[3] = {0, 0, 0};
+      if (h >= 10) {
+        label[0] = '1';
+        label[1] = '0' + h % 10;
+      } else {
+        label[0] = '0' + h;
+      }
+      c->centeredText(label, k_mediumFont, cx + rr * std::sin(angle), cy - rr * std::cos(angle) - 10, h % 3 == 0 ? accent : text, a);
+    }
+    // Date complication
+    char day[3] = {0, 0, 0};
+    twoDigits(day, d.day);
+    c->fillRoundedRect(cx + 26, cy - 11, 30, 22, 6, darkText() ? rgb(0xE5E5EA) : k_cardBackground, a);
+    c->centeredText(day, k_mediumFont, cx + 41, cy - 10, accent, a);
+  }
+  if (d.clockIsSet) {
+    drawHands(c, d, cx, cy, r, text, accent, a, !numbers);
+  }
+  // Complications in the corners
+  drawBattery(c, d, 30, 214, 15, text, a);
+  drawRings(c, k_width - 30, 214, 15, a);
+}
+
+static void drawModular(Canvas* c, const FaceData& d, KDColor text, KDColor secondary, KDColor accent, int a) {
+  char date[40];
+  formatDate(date, d);
+  c->text(date, k_mediumFont, 18, 18, accent, a);
+  char time[6] = "--:--";
+  if (d.clockIsSet) {
+    twoDigits(time, d.hour);
+    twoDigits(time + 3, d.minute);
+  }
+  c->text(time, k_clockFont, 14, 34, text, a, 0.82f);
+  // Three complications in cards
+  constexpr float y = 150, w = 92, h = 72, gap = 9;
+  KDColor card = darkText() ? rgb(0xE5E5EA) : k_cardBackground;
+  for (int i = 0; i < 3; i++) {
+    float x = 14 + i * (w + gap);
+    c->fillRoundedRect(x, y, w, h, 14, card, a * 3 / 4);
+  }
+  drawBattery(c, d, 14 + w / 2, y + h / 2, 22, text, a);
+  drawRings(c, 14 + w + gap + w / 2, y + h / 2, 24, a);
+  float x3 = 14 + 2 * (w + gap) + w / 2;
+  c->centeredText("STI2D", k_mediumFont, x3, y + 16, accent, a);
+  c->centeredText("OS", k_mediumFont, x3, y + 36, text, a);
+}
+
+void drawWatchFace(Canvas* canvas, const FaceData& data, int alpha, bool withBackground) {
+  if (withBackground) {
+    Style::drawBackground(canvas, 0);
+  }
+  if (Style::theme() != Theme::Classic) {
+    if (alpha >= 256) {
+      drawScenery(canvas, 256);
+    } else if (alpha > 0) {
+      /* Sceneries are made of opaque layers: fade them by darkening toward
+       * the background once drawn. */
+      drawScenery(canvas, 256);
+      canvas->darkenRows(canvas->top(), canvas->bottom(), 256 - alpha, 256 - alpha);
+    }
+  }
+  bool dark = darkText();
+  KDColor text = dark ? KDBlack : KDWhite;
+  KDColor secondary = dark ? rgb(0x555555) : k_secondaryText;
+  KDColor accent = Style::accent();
+  switch (Style::face()) {
+    case Style::Face::Analog:
+      return drawAnalog(canvas, data, text, secondary, accent, alpha, true);
+    case Style::Face::Minimal:
+      return drawAnalog(canvas, data, text, secondary, accent, alpha, false);
+    case Style::Face::Modular:
+      return drawModular(canvas, data, text, secondary, accent, alpha);
+    default:
+      return drawDigital(canvas, data, text, secondary, accent, alpha);
+  }
+}
+
+}  // namespace STI2D
