+  --green: #30d158;
+  --red: #ff453a;
+}
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.5 -apple-system, "Segoe UI", Inter, Roboto, sans-serif; }
+main { max-width: 680px; margin: 0 auto; padding: 32px 16px 64px; }
+.logo { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
+.logo svg { flex: none; }
+h1 { font-size: 34px; margin: 0; letter-spacing: -0.5px; }
+.subtitle { color: var(--muted); margin: 0 0 28px; }
+.card { background: var(--card); border-radius: 18px; padding: 18px 20px; margin: 14px 0; }
+.card h2 { font-size: 17px; margin: 0 0 8px; color: var(--accent); }
+.card p, .card li { color: #d1d1d6; }
+ol { padding-left: 22px; margin: 6px 0; }
+label { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
+input[type=text] { background: var(--card2); color: var(--text); border: 1px solid #3a3a3c; border-radius: 10px; padding: 8px 12px; font-size: 16px; width: 120px; }
+input[type=checkbox] { width: 20px; height: 20px; accent-color: var(--accent); }
+button { background: var(--accent); color: #000; border: 0; border-radius: 14px; padding: 14px 22px; font-size: 18px; font-weight: 700; cursor: pointer; width: 100%; }
+button:disabled { background: #3a3a3c; color: var(--muted); cursor: default; }
+.progress { height: 10px; background: var(--card2); border-radius: 5px; overflow: hidden; margin: 14px 0 8px; }
+.bar { height: 100%; width: 0; background: linear-gradient(90deg, #fa1150, #ff9f0a); transition: width .15s; }
+#log { color: var(--muted); font: 13px/1.5 ui-monospace, Menlo, Consolas, monospace; white-space: pre-wrap; max-height: 180px; overflow: auto; }
+.ok { color: var(--green); }
+.err { color: var(--red); }
+.warn { border-left: 4px solid var(--accent); }
+small { color: var(--muted); }
+a { color: var(--accent); }
+</style>
+</head>
+<body>
+<main>
+  <div class="logo">
+    <svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true">
+      <g fill="none" stroke-linecap="round" stroke-width="6">
+        <circle cx="28" cy="28" r="24" stroke="#fa1150" stroke-opacity=".25"/>
+        <circle cx="28" cy="28" r="24" stroke="#fa1150" stroke-dasharray="124 200" transform="rotate(-90 28 28)"/>
+        <circle cx="28" cy="28" r="16" stroke="#a0ff14" stroke-opacity=".25"/>
+        <circle cx="28" cy="28" r="16" stroke="#a0ff14" stroke-dasharray="64 200" transform="rotate(-90 28 28)"/>
+        <circle cx="28" cy="28" r="8" stroke="#00f0ff" stroke-opacity=".25"/>
+        <circle cx="28" cy="28" r="8" stroke="#00f0ff" stroke-dasharray="45 200" transform="rotate(-90 28 28)"/>
+      </g>
+    </svg>
+    <h1>STI2D OS</h1>
+  </div>
+  <p class="subtitle">Installateur pour NumWorks N0120 · par Yamii et Derim · <span id="build"></span></p>
+
+  <div class="card warn">
+    <h2>Avant de commencer</h2>
+    <ol>
+      <li>Utilise <b>Chrome</b> ou <b>Edge</b> sur ordinateur, et ferme les onglets my.numworks.com.</li>
+      <li>Ta calculatrice doit être à jour sur <a href="https://my.numworks.com/devices/upgrade">my.numworks.com</a>.</li>
+      <li>Sauvegarde tes scripts Python : l'installation efface la plupart des données.</li>
+      <li>Branche la calculatrice : elle affiche « La calculatrice est connectée ».</li>
+    </ol>
+    <small>STI2D OS s'installe à côté du système officiel. Après un reset (ou un plantage), la calculatrice revient au système officiel : il suffit alors de relancer cet installateur.</small>
+  </div>
+
+  <div class="card">
+    <h2>Options</h2>
+    <label>Version d'Epsilon de ta calculatrice
+      <input type="text" id="version" value="26.4.0" spellcheck="false">
+    </label>
+    <small>Paramètres › À propos › Version du logiciel. STI2D OS doit déclarer la même version que le système officiel.</small>
+    <label><input type="checkbox" id="games" checked> Préinstaller STI2D-Play (24 jeux et Matrices IA, 2,4 Mo)</label>
+    <small>Décoche pour garder les 2,4 Mo libres et installer tes propres apps .nwa sur <a href="https://my.numworks.com/apps">my.numworks.com/apps</a>.</small>
+  </div>
+
+  <div class="card">
+    <button id="install">Installer STI2D OS</button>
+    <div class="progress"><div class="bar" id="bar"></div></div>
+    <div id="status"><small>Prêt.</small></div>
+    <div id="log"></div>
+  </div>
+</main>
+<script>
+"use strict";
+const PAYLOAD = /*PAYLOAD*/null;
+
+const $ = (id) => document.getElementById(id);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const log = (text, cls) => {
+  const line = document.createElement("div");
+  if (cls) line.className = cls;
+  line.textContent = text;
+  $("log").appendChild(line);
+  $("log").scrollTop = 1e9;
+};
+const setStatus = (text, cls) => { $("status").innerHTML = ""; const s = document.createElement("span"); s.textContent = text; if (cls) s.className = cls; $("status").appendChild(s); };
+const hex = (n) => "0x" + n.toString(16).padStart(8, "0");
+$("build").textContent = PAYLOAD ? PAYLOAD.build : "";
+
+async function inflate(base64) {
+  const bytes = Uint8Array.from(atob(base64), (c) => c.charCodeAt(0));
+  const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"));
+  return new Uint8Array(await new Response(stream).arrayBuffer());
+}
+
+// ---------------------------------------------------------------- DfuSe over WebUSB
+const DNLOAD = 1, GETSTATUS = 3, CLRSTATUS = 4, ABORT = 6;
+const STATE_IDLE = 2, STATE_DN_BUSY = 4, STATE_DN_IDLE = 5, STATE_MANIFEST = 7, STATE_UP_IDLE = 9, STATE_ERROR = 10;
+
+class Dfu {
+  constructor(device) { this.device = device; this.transferSize = 2048; }
+  setup(request, value) { return { requestType: "class", recipient: "interface", request, value, index: 0 }; }
+  out(request, value, data) { return this.device.controlTransferOut(this.setup(request, value), data); }
+  async status() {
+    const r = await this.device.controlTransferIn(this.setup(GETSTATUS, 0), 6);
+    const d = r.data;
+    const poll = d.getUint8(1) | (d.getUint8(2) << 8) | (d.getUint8(3) << 16);
+    if (poll > 0) await sleep(Math.min(poll, 5000));
+    return { status: d.getUint8(0), state: d.getUint8(4) };
+  }
+  async waitIdle(what) {
+    for (let i = 0; i < 1000; i++) {
+      const s = await this.status();
+      if (s.state === STATE_DN_IDLE || s.state === STATE_IDLE) return;
+      if (s.state === STATE_ERROR) { await this.out(CLRSTATUS, 0); throw new Error(what + " : erreur DFU (statut " + s.status + ")"); }
+      if (s.state === STATE_MANIFEST) return;
+    }
+    throw new Error(what + " : la calculatrice ne répond plus");
+  }
+  async command(byte, address, what) {
+    const buf = new Uint8Array(5);
+    buf[0] = byte;
+    new DataView(buf.buffer).setUint32(1, address, true);
+    await this.out(DNLOAD, 0, buf);
+    await this.waitIdle(what);
+  }
+  setAddress(address) { return this.command(0x21, address, "adresse " + hex(address)); }
+  erasePage(address) { return this.command(0x41, address, "effacement " + hex(address)); }
+  async write(address, data, onProgress) {
+    for (let offset = 0; offset < data.length; offset += this.transferSize) {
+      await this.setAddress(address + offset);
+      await this.out(DNLOAD, 2, data.subarray(offset, Math.min(offset + this.transferSize, data.length)));
+      await this.waitIdle("écriture " + hex(address + offset));
+      onProgress(Math.min(this.transferSize, data.length - offset));
+    }
+  }
+  async leave(address) {
+    await this.setAddress(address);
+    await this.out(DNLOAD, 2, new Uint8Array(0));
+    try { await this.status(); } catch (e) { /* The calculator restarts */ }
+  }
+  async open() {
+    const d = this.device;
+    await d.open();
+    if (d.configuration === null) await d.selectConfiguration(1);
+    await d.claimInterface(0);
+    await d.selectAlternateInterface(0, 0);
+    this.transferSize = await this.readTransferSize();
+    for (let i = 0; i < 4; i++) {
+      const s = await this.status();
+      if (s.state === STATE_IDLE) break;
+      if (s.state === STATE_DN_IDLE || s.state === STATE_UP_IDLE) await this.out(ABORT, 0);
+      else await this.out(CLRSTATUS, 0);
+    }
+  }
+  async readTransferSize() {
+    try {
+      const r = await this.device.controlTransferIn({ requestType: "standard", recipient: "device", request: 6, value: 0x0200, index: 0 }, 1024);
+      const b = new Uint8Array(r.data.buffer);
+      for (let i = 0; i + 1 < b.length && b[i] > 0; i += b[i]) {
+        if (b[i + 1] === 0x21 && b[i] >= 7) return b[i + 5] | (b[i + 6] << 8);
+      }
+    } catch (e) { /* Keep the default */ }
+    return 2048;
+  }
+  // "@Flash/0x90000000/08*004Kg,01*032Kg,..." → [{start, end, pageSize}]
+  layout() {
+    const name = this.device.configuration.interfaces[0].alternates[0].interfaceName || "";
+    const parts = name.split("/");
+    const segments = [];
+    for (let i = 1; i + 1 < parts.length; i += 2) {
+      let address = parseInt(parts[i], 16);
+      for (const seg of parts[i + 1].split(",")) {
+        const m = /(\d+)\*(\d+)(.)/.exec(seg);
+        if (!m) continue;
+        const pageSize = parseInt(m[2], 10) * (m[3] === "K" ? 1024 : m[3] === "M" ? 1048576 : 1);
+        const size = parseInt(m[1], 10) * pageSize;
+        segments.push({ start: address, end: address + size, pageSize });
+        address += size;
+      }
+    }
+    return segments;
+  }
+}
+
+// ---------------------------------------------------------------- Installation
+async function install() {
+  $("install").disabled = true;
+  $("log").textContent = "";
+  $("bar").style.width = "0";
+  try {
+    if (!("usb" in navigator)) throw new Error("Ce navigateur ne gère pas WebUSB : utilise Chrome ou Edge sur ordinateur.");
+    const version = $("version").value.trim();
+    if (!/^\d+\.\d+\.\d+$/.test(version) || version.length > 7) throw new Error("Version invalide : écris-la comme 26.4.0");
+
+    setStatus("Choisis ta calculatrice dans la fenêtre…");
+    const device = await navigator.usb.requestDevice({ filters: [{ vendorId: 0x0483, productId: 0xa291 }] });
+    const dfu = new Dfu(device);
+    await dfu.open();
+    const model = "n0" + device.deviceVersionMajor.toString(16) + device.deviceVersionMinor.toString(16) + device.deviceVersionSubminor.toString(16);
+    log("Calculatrice : " + model.toUpperCase() + ", transferts de " + dfu.transferSize + " octets");
+    if (model !== "n0120") throw new Error("STI2D OS est fait pour la N0120 (calculatrice détectée : " + model.toUpperCase() + ").");
+    const layout = dfu.layout();
+    const writable = (a) => layout.some((s) => a >= s.start && a < s.end);
+    let slot = null;
+    if (writable(0x90400000) && !writable(0x90000000)) slot = "B";
+    if (writable(0x90000000) && !writable(0x90400000)) slot = "A";
+    if (!slot) throw new Error("Impossible de trouver l'emplacement libre de la calculatrice. Débranche-la, rebranche-la et réessaie.");
+    log("Le système officiel tourne sur l'emplacement " + (slot === "A" ? "B" : "A") + " : STI2D OS va sur l'emplacement " + slot);
+
+    setStatus("Préparation des fichiers…");
+    const target = PAYLOAD.slots[slot];
+    const segments = [];
+    for (const s of target.segments) segments.push({ address: s.address, data: await inflate(s.data) });
+    // The userland declares the version of the official software it runs on
+    const userland = segments[0].data;
+    for (let i = 0; i < 8; i++) userland[target.versionOffset + i] = i < version.length ? version.charCodeAt(i) : 0;
+    log("Version déclarée : " + version);
+
+    let end = target.appsStart;
+    if ($("games").checked) {
+      const apps = await inflate(target.apps.data);
+      segments.push({ address: target.appsStart, data: apps });
+      end = target.appsStart + apps.length;
+      log("STI2D-Play : " + (apps.length / 1048576).toFixed(2) + " Mo sur " + ((target.appsEnd - target.appsStart) / 1048576).toFixed(2) + " Mo");
+    }
+    // Erase the sector after the apps, so that no former app is found there
+    const pageSize = 0x10000;
+    const nextPage = Math.ceil(end / pageSize) * pageSize;
+    if (nextPage < target.appsEnd) segments.push({ address: nextPage, data: new Uint8Array(0), eraseOnly: true });
+    // The userland is written last, stamped with the time at which it starts
+    segments[0].stamp = true;
+    segments.push(segments.shift());
+
+    const total = segments.reduce((n, s) => n + s.data.length, 0);
+    let done = 0;
+    const progress = (n) => { done += n; $("bar").style.width = (100 * done / total).toFixed(1) + "%"; };
+    setStatus("Installation… ne débranche pas la calculatrice.");
+    const started = performance.now();
+    for (const s of segments) {
+      if (s.stamp) {
+        /* The clock of STI2D OS starts at this time (seconds since 2000, UTC):
+         * now, plus the time the userland takes to be written at the speed
+         * measured so far. */
+        const rate = done > 0 ? done / ((performance.now() - started) / 1000) : 40000;
+        const seconds = Math.round(Date.now() / 1000 + s.data.length / rate + 2);
+        new DataView(s.data.buffer).setUint32(target.installTimeOffset, seconds - 946684800, true);
+        log("Heure de démarrage prévue : " + new Date(seconds * 1000).toLocaleTimeString("fr-FR"));
+      }
+      const length = Math.max(s.data.length, 1);
+      for (let page = Math.floor(s.address / pageSize) * pageSize; page < s.address + length; page += pageSize) {
+        await dfu.erasePage(page);
+      }
+      if (!s.eraseOnly) {
+        log("Écriture de " + (s.data.length / 1024).toFixed(0) + " Ko à " + hex(s.address));
+        await dfu.write(s.address, s.data, progress);
+      }
+    }
+    $("bar").style.width = "100%";
+    log("Démarrage de STI2D OS…");
+    await dfu.leave(target.leave);
+    setStatus("STI2D OS est installé ! La calculatrice redémarre dessus.", "ok");
+    log("Terminé.", "ok");
+  } catch (e) {
+    if (e && e.name === "NotFoundError") setStatus("Aucune calculatrice choisie.");
+    else { setStatus(e.message || String(e), "err"); log(String(e), "err"); }
+  } finally {
+    $("install").disabled = false;
+  }
+}
+$("install").addEventListener("click", install);
+</script>
+</body>
+</html>
diff --git a/tools/sti2d/make_fonts.py b/tools/sti2d/make_fonts.py
new file mode 100644
index 0000000..9feccad
--- /dev/null
+++ b/tools/sti2d/make_fonts.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Rasterize the STI2D OS fonts (Inter, SIL Open Font License) into
+anti-aliased 4-bit glyph atlases, compiled into the firmware.
+
+Epsilon stores its strings in NFKD form (letters followed by combining
+accents), so a composition table is also generated to draw "é" with its
+precomposed glyph."""
+import os
+import sys
+import unicodedata
+from PIL import Image, ImageDraw, ImageFont
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+OUT = sys.argv[1]
+
+TEXT_CHARS = [chr(c) for c in range(0x20, 0x7F)] + [chr(c) for c in range(0xC0, 0x100) if c != 0xD7 and c != 0xF7] + list("œŒ’…–°·×÷ÿŸ")
+FONTS = [
+    # name, file, pixel size, characters, tabular digits
+    ("Small", "Inter-SemiBold.ttf", 13, TEXT_CHARS, False),
+    ("Medium", "Inter-SemiBold.ttf", 17, TEXT_CHARS, True),
+    ("Title", "InterDisplay-Bold.ttf", 30, TEXT_CHARS, False),
+    ("Clock", "InterDisplay-SemiBold.ttf", 84, list("0123456789:-"), True),
+]
+
+def rasterize(path, size, chars, tabular):
+    font = ImageFont.truetype(os.path.join(HERE, path), size)
+    ascent, descent = font.getmetrics()
+    digitAdvance = max(font.getlength(d) for d in "0123456789")
+    glyphs = []
+    for ch in sorted(set(chars)):
+        bbox = font.getbbox(ch)
+        advance = font.getlength(ch)
+        if tabular and ch.isdigit():
+            advance = digitAdvance
+        w, h = max(bbox[2] - bbox[0], 0), max(bbox[3] - bbox[1], 0)
+        pixels = []
+        if w > 0 and h > 0:
+            img = Image.new("L", (w, h), 0)
+            ImageDraw.Draw(img).text((-bbox[0], -bbox[1]), ch, font=font, fill=255)
+            pixels = [min(15, (v + 8) // 17) for v in img.tobytes()]
+        offsetX = bbox[0]
+        if tabular and ch.isdigit():
+            # Center the digit in its fixed advance
+            offsetX = int(round((advance - w) / 2))
+        glyphs.append((ord(ch), offsetX, bbox[1], w, h, int(round(advance)), pixels))
+    return ascent, descent, glyphs
+
+def compositions():
+    table = []
+    for c in range(0xC0, 0x180):
+        ch = chr(c)
+        d = unicodedata.normalize("NFD", ch)
+        if len(d) == 2:
+            table.append((ord(d[0]), ord(d[1]), c))
+    for ch in "ÿŸ":
+        d = unicodedata.normalize("NFD", ch)
+        table.append((ord(d[0]), ord(d[1]), ord(ch)))
+    return sorted(set(table))
+
+out = ["// Generated by tools/sti2d/make_fonts.py, do not edit", '#include "fonts.h"', "", "namespace STI2D {", ""]
+for name, path, size, chars, tabular in FONTS:
+    ascent, descent, glyphs = rasterize(path, size, chars, tabular)
+    data = bytearray()
+    entries = []
+    for cp, ox, oy, w, h, adv, px in glyphs:
+        offset = len(data)
+        for i in range(0, len(px), 2):
+            a = px[i]
+            b = px[i + 1] if i + 1 < len(px) else 0
+            data.append((a << 4) | b)
+        entries.append(f"  {{0x{cp:04X}, {offset}, {ox}, {oy}, {w}, {h}, {adv}}},")
+    out.append(f"static const uint8_t s_{name}Data[] = {{")
+    for i in range(0, len(data), 24):
+        out.append("  " + ", ".join(str(b) for b in data[i:i + 24]) + ",")
+    out.append("};")
+    out.append(f"static const Font::Glyph s_{name}Glyphs[] = {{")
+    out.extend(entries)
+    out.append("};")
+    out.append(f"const Font k_{name.lower()}Font = {{s_{name}Glyphs, {len(glyphs)}, s_{name}Data, {ascent}, {descent}}};")
+    out.append("")
+out.append("const Composition k_compositions[] = {")
+comps = compositions()
+for base, mark, result in comps:
+    out.append(f"  {{0x{base:04X}, 0x{mark:04X}, 0x{result:04X}}},")
+out.append("};")
+out.append(f"const int k_numberOfCompositions = {len(comps)};")
+out.append("")
+out.append("}  // namespace STI2D")
+open(OUT, "w").write("\n".join(out) + "\n")
diff --git a/tools/sti2d/make_icons.py b/tools/sti2d/make_icons.py
new file mode 100644
index 0000000..e74b5b1
--- /dev/null
+++ b/tools/sti2d/make_icons.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Generate the round, watchOS-like app icons of STI2D OS.
+
+The glyph of each original Epsilon icon is extracted and painted in white on
+top of a colorful gradient bubble, on a black background (the home screen is
+black). The same icon is used for the light and the dark themes.
+
+Usage: make_icons.py <directory of the original light icons> <apps/icons>"""
+import os
+import sys
+from PIL import Image, ImageDraw, ImageFilter
+
+SRC, DST = sys.argv[1], sys.argv[2]
+SS = 4  # Supersampling factor
+W, H = 55, 56
+
+COLORS = {
+    "calculation": ("ffb340", "f57c00"),
+    "graph": ("4fa8ff", "0a5fd6"),
+    "code": ("5ee07e", "1e9e43"),
+    "stat": ("d785ff", "8e2fd0"),
+    "distributions": ("ff6a85", "d81e4a"),
+    "inference": ("8583ff", "3d39c9"),
+    "solver": ("7fdcff", "1a9fd6"),
+    "sequence": ("6fe8d8", "1aa597"),
+    "regression": ("ff7a6e", "d42a1e"),
+    "elements": ("c08bff", "6a3fc9"),
+    "finance": ("ffd24d", "e09a00"),
+    "settings": ("a2a2a8", "55555c"),
+}
+
+def hexc(h):
+    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
+
+def dist(a, b):
+    return max(abs(a[i] - b[i]) for i in range(3))
+
+def glyph_mask(path):
+    src = Image.open(path).convert("RGB")
+    w, h = src.size
+    # The background is the most common color on a ring inside the frame
+    samples = [src.getpixel((x, 6)) for x in range(6, w - 6)] + [src.getpixel((6, y)) for y in range(6, h - 6)]
+    samples += [src.getpixel((x, h - 7)) for x in range(6, w - 6)] + [src.getpixel((w - 7, y)) for y in range(6, h - 6)]
+    counts = {}
+    for c in samples:
+        key = tuple(v // 12 for v in c)
+        counts.setdefault(key, []).append(c)
+    bg = max(counts.values(), key=len)
+    bg = tuple(sum(c[i] for c in bg) // len(bg) for i in range(3))
+    mask = Image.new("L", src.size, 0)
+    for y in range(h):
+        for x in range(w):
+            # Skip the frame of the original icon
+            if x < 4 or y < 4 or x >= w - 4 or y >= h - 4:
+                continue
+            d = dist(src.getpixel((x, y)), bg)
+            mask.putpixel((x, y), max(0, min(255, (d - 34) * 255 // 60)))
+    return mask
+
+def bubble(top, bottom):
+    size = (W * SS, H * SS)
+    img = Image.new("RGB", size, (0, 0, 0))
+    grad = Image.new("RGB", size)
+    t, b = hexc(top), hexc(bottom)
+    draw = ImageDraw.Draw(grad)
+    for y in range(size[1]):
+        k = y / (size[1] - 1)
+        draw.line([(0, y), (size[0], y)], fill=tuple(int(t[i] + (b[i] - t[i]) * k) for i in range(3)))
+    circle = Image.new("L", size, 0)
+    d = 54 * SS
+    ox, oy = (size[0] - d) // 2, (size[1] - d) // 2
+    ImageDraw.Draw(circle).ellipse([ox, oy, ox + d - 1, oy + d - 1], fill=255)
+    img.paste(grad, (0, 0), circle)
+    # Soft glossy highlight on the upper half
+    gloss = Image.new("L", size, 0)
+    ImageDraw.Draw(gloss).ellipse([ox + 8 * SS, oy + 2 * SS, ox + d - 8 * SS, oy + d // 2], fill=38)
+    gloss = gloss.filter(ImageFilter.GaussianBlur(5 * SS))
+    img.paste((255, 255, 255), (0, 0), Image.composite(gloss, Image.new("L", size, 0), circle))
+    return img, circle
+
+for name, (top, bottom) in COLORS.items():
+    img, circle = bubble(top, bottom)
+    mask = glyph_mask(os.path.join(SRC, f"{name}_light_icon.png"))
+    scale = 0.74
+    gw, gh = int(W * SS * scale), int(H * SS * scale)
+    big = mask.resize((gw, gh), Image.LANCZOS)
+    full = Image.new("L", img.size, 0)
+    full.paste(big, ((img.width - gw) // 2, (img.height - gh) // 2))
+    # Subtle drop shadow under the glyph
+    shadow = full.filter(ImageFilter.GaussianBlur(2 * SS)).point(lambda v: v * 0.35)
+    img.paste((0, 0, 0), (0, SS), Image.composite(shadow, Image.new("L", img.size, 0), circle))
+    img.paste((255, 255, 255), (0, 0), Image.composite(full, Image.new("L", img.size, 0), circle))
+    out = img.resize((W, H), Image.LANCZOS)
+    for theme in ("light", "dark"):
+        out.convert("RGBA").save(os.path.join(DST, theme, f"{name}_{theme}_icon.png"))
diff --git a/tools/sti2d/make_media.py b/tools/sti2d/make_media.py
new file mode 100644
index 0000000..f1bccec
--- /dev/null
+++ b/tools/sti2d/make_media.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Render the STI2D OS presentation media with the simulator: screenshots,
+animated GIFs and MP4 clips of every animation.
+
+Usage: make_media.py <epsilon.bin> <output directory>
+
+The simulator replays key events headlessly. Animation frames are frozen at a
+given time with STI2D_FREEZE_MS (see apps/sti2d/animation.h)."""
+import os
+import subprocess
+import sys
+import tempfile
+
+SIM, OUT = os.path.abspath(sys.argv[1]), sys.argv[2]
+LEFT, UP, DOWN, RIGHT, OK, BACK, HOME = 0, 1, 2, 3, 4, 5, 6
+DIGITS = {1: 42, 2: 43, 3: 44, 4: 36, 5: 37, 6: 38, 7: 30, 8: 31, 9: 32}
+SCALE = 3  # 960x720, crisp pixels for videos
+TMP = tempfile.mkdtemp()
+
+def shot(path, events=(), freeze=None, skip=0, lang="fr", demo=True):
+    """Render the screen after the events, or a frozen animation frame."""
+    state = os.path.join(TMP, "events.nws")
+    with open(state, "wb") as f:
+        f.write(b"NWSF**.**.**" + bytes([1]) + lang.encode() + bytes(events))
+    env = dict(os.environ)
+    if demo:
+        env["STI2D_DEMO_APPS"] = "1"
+    ppm = os.path.join(TMP, "frame.ppm")
+    if os.path.exists(ppm):
+        os.remove(ppm)
+    args = [SIM, "--headless", "-l", state, "--take-screenshot"]
+    if freeze is not None:
+        env.update(STI2D_FREEZE_MS=str(int(freeze)), STI2D_FREEZE_SKIP=str(skip), STI2D_HOLD=ppm)
+        args.append(os.path.join(TMP, "unused.png"))
+        subprocess.run(args, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
+        subprocess.check_call(["convert", ppm, path])
+    else:
+        args.append(path)
+        subprocess.run(args, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
+
+def upscale(src, dst):
+    subprocess.check_call(["convert", src, "-filter", "point", "-resize", f"{SCALE * 100}%", dst])
+
+class Clip:
+    """A sequence of frames, each shown for a duration in ms."""
+    def __init__(self, name):
+        self.name = name
+        self.frames = []
+        self.dir = os.path.join(TMP, name)
+        os.makedirs(self.dir, exist_ok=True)
+
+    def add(self, duration, **kwargs):
+        path = os.path.join(self.dir, f"{len(self.frames):04d}.png")
+        shot(path, **kwargs)
+        self.frames.append((path, duration))
+
+    def animation(self, events, number, duration, step=20, **kwargs):
+        """Add the frames of the number-th animation (1 is the boot)."""
+        t = 0
+        while t < duration:
+            self.add(step, events=events, freeze=t, skip=number - 1, **kwargs)
+            t += step
+        self.add(step, events=events, freeze=duration, skip=number - 1, **kwargs)
+
+    def save(self):
+        gif_dir = os.path.join(OUT, "animations-gif")
+        mp4_dir = os.path.join(OUT, "animations-mp4")
+        os.makedirs(gif_dir, exist_ok=True)
+        os.makedirs(mp4_dir, exist_ok=True)
+        # GIF, at twice the size of the screen
+        args = ["convert", "-loop", "0"]
+        for path, duration in self.frames:
+            args += ["-delay", str(max(2, round(duration / 10))), path]
+        args += ["-filter", "point", "-resize", "200%", "-layers", "Optimize",
+                 os.path.join(gif_dir, self.name + ".gif")]
+        subprocess.check_call(args)
+        # MP4 at 60 fps, 960x720, for video editing
+        concat = os.path.join(self.dir, "list.txt")
+        with open(concat, "w") as f:
+            for path, duration in self.frames:
+                f.write(f"file '{path}'\nduration {duration / 1000:.3f}\n")
+            f.write(f"file '{self.frames[-1][0]}'\n")
+        subprocess.check_call(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", concat,
+                               "-vf", f"scale={320 * SCALE}:{240 * SCALE}:flags=neighbor,fps=60,format=yuv420p",
+                               "-c:v", "libx264", "-crf", "16", os.path.join(mp4_dir, self.name + ".mp4")])
+        print("clip", self.name, len(self.frames), "frames")
+
+os.makedirs(OUT, exist_ok=True)
+shots_dir = os.path.join(OUT, "captures")
+os.makedirs(shots_dir, exist_ok=True)
+
+def capture(name, **kwargs):
+    raw = os.path.join(TMP, name + ".png")
+    shot(raw, **kwargs)
+    upscale(raw, os.path.join(shots_dir, name + ".png"))
+    print("capture", name)
+
+# ---------------------------------------------------------------- captures
