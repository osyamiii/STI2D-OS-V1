diff --git a/epsilon/apps/sti2d/fonts.h b/epsilon/apps/sti2d/fonts.h
new file mode 100644
index 0000000..42b0f05
--- /dev/null
+++ b/epsilon/apps/sti2d/fonts.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace STI2D {
+
+/* Anti-aliased fonts of STI2D OS, rasterized from Inter at build time (see
+ * tools/sti2d/make_fonts.py). Each glyph is a 4-bit alpha bitmap. */
+struct Font {
+  struct Glyph {
+    uint16_t codePoint;
+    uint32_t dataOffset;
+    int8_t offsetX;  // From the pen position to the left of the bitmap
+    int8_t offsetY;  // From the top of the line to the top of the bitmap
+    uint8_t width;
+    uint8_t height;
+    uint8_t advance;
+  };
+  const Glyph* glyphs;
+  int numberOfGlyphs;
+  const uint8_t* data;
+  int ascent;
+  int descent;
+
+  const Glyph* glyph(uint32_t codePoint) const;
+  int lineHeight() const { return ascent + descent; }
+};
+
+struct Composition {
+  uint16_t base;
+  uint16_t mark;
+  uint16_t result;
+};
+
+extern const Font k_smallFont;
+extern const Font k_mediumFont;
+extern const Font k_titleFont;
+extern const Font k_clockFont;
+extern const Composition k_compositions[];
+extern const int k_numberOfCompositions;
+
+}  // namespace STI2D
