diff --git a/epsilon/apps/sti2d/canvas.cpp b/epsilon/apps/sti2d/canvas.cpp
index 2022e20..1984a99 100644
--- a/epsilon/apps/sti2d/canvas.cpp
+++ b/epsilon/apps/sti2d/canvas.cpp
@@ -562,4 +562,106 @@ void Canvas::centeredText(const char* text, const Font& font, float cx,
   this->text(text, font, x, y, color, alpha, scale);
 }
 
+void Canvas::capsule(float x0, float y0, float x1, float y1, float radius,
+                     KDColor color, int alpha) {
+  float top = minFloat(y0, y1) - radius - 1.0f;
+  float bottom = maxFloat(y0, y1) + radius + 1.0f;
+  if (alpha <= 0 || !intersects(top, bottom)) {
+    return;
+  }
+  float left = minFloat(x0, x1) - radius - 1.0f;
+  float right = maxFloat(x0, x1) + radius + 1.0f;
+  float dx = x1 - x0, dy = y1 - y0;
+  float length2 = dx * dx + dy * dy;
+  int ya = clampInt(floorInt(top), m_bandTop, m_bandBottom);
+  int yb = clampInt(ceilInt(bottom), m_bandTop, m_bandBottom);
+  for (int y = ya; y < yb; y++) {
+    float py = y + 0.5f;
+    for (int x = floorInt(left); x < ceilInt(right); x++) {
+      float px = x + 0.5f;
+      // Distance from the pixel to the segment
+      float t = length2 > 0.0f ? ((px - x0) * dx + (py - y0) * dy) / length2
+                               : 0.0f;
+      t = clamp01(t);
+      float ex = px - (x0 + t * dx), ey = py - (y0 + t * dy);
+      int c = coverage(radius - std::sqrt(ex * ex + ey * ey));
+      if (c > 0) {
+        blendPixel(x, y, color, c * alpha >> 8);
+      }
+    }
+  }
+}
+
+void Canvas::fillTriangle(float x0, float y0, float x1, float y1, float x2,
+                          float y2, KDColor color, int alpha) {
+  float top = minFloat(y0, minFloat(y1, y2));
+  float bottom = maxFloat(y0, maxFloat(y1, y2));
+  if (alpha <= 0 || !intersects(top - 1, bottom + 1)) {
+    return;
+  }
+  float left = minFloat(x0, minFloat(x1, x2));
+  float right = maxFloat(x0, maxFloat(x1, x2));
+  // Signed distances to the three edges, positive inside
+  float area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0);
+  float sign = area < 0.0f ? -1.0f : 1.0f;
+  float ex[3] = {x0, x1, x2}, ey[3] = {y0, y1, y2};
+  float nx[3], ny[3], len[3];
+  for (int i = 0; i < 3; i++) {
+    int j = (i + 1) % 3;
+    nx[i] = -(ey[j] - ey[i]) * sign;
+    ny[i] = (ex[j] - ex[i]) * sign;
+    len[i] = std::sqrt(nx[i] * nx[i] + ny[i] * ny[i]);
+    len[i] = len[i] > 0.0f ? len[i] : 1.0f;
+  }
+  int ya = clampInt(floorInt(top), m_bandTop, m_bandBottom);
+  int yb = clampInt(ceilInt(bottom), m_bandTop, m_bandBottom);
+  for (int y = ya; y < yb; y++) {
+    float py = y + 0.5f;
+    for (int x = floorInt(left); x < ceilInt(right); x++) {
+      float px = x + 0.5f;
+      float d = 1e9f;
+      for (int i = 0; i < 3; i++) {
+        float di = ((px - ex[i]) * nx[i] + (py - ey[i]) * ny[i]) / len[i];
+        d = di < d ? di : d;
+      }
+      int c = coverage(d);
+      if (c > 0) {
+        blendPixel(x, y, color, c * alpha >> 8);
+      }
+    }
+  }
+}
+
+extern "C" int LZ4_decompress_safe(const char* src, char* dst, int srcSize,
+                                   int dstCapacity);
+
+void Canvas::wallpaper(const uint8_t* data, int dim) {
+  /* Layout: "STWP", width (16 bits), height (16 bits), then for each band of
+   * k_wallpaperBandHeight rows the offset (32 bits) of its LZ4 block from the
+   * start of the data, and the end offset of the last block. */
+  constexpr int width = Ion::Display::Width;
+  constexpr int bands = Ion::Display::Height / k_wallpaperBandHeight;
+  const uint32_t* offsets = reinterpret_cast<const uint32_t*>(data + 8);
+  KDColor rows[width * k_wallpaperBandHeight];
+  int decodedBand = -1;
+  for (int y = m_bandTop; y < m_bandBottom; y++) {
+    int band = y / k_wallpaperBandHeight;
+    if (band >= bands) {
+      break;
+    }
+    if (band != decodedBand) {
+      LZ4_decompress_safe(reinterpret_cast<const char*>(data + offsets[band]),
+                          reinterpret_cast<char*>(rows),
+                          offsets[band + 1] - offsets[band], sizeof(rows));
+      decodedBand = band;
+    }
+    const KDColor* source =
+        rows + (y % k_wallpaperBandHeight) * width + m_area.left();
+    KDColor* destination = m_buffer + (y - m_bandTop) * m_area.width();
+    for (int x = 0; x < m_area.width(); x++) {
+      destination[x] = dim > 0 ? mix(source[x], KDBlack, dim) : source[x];
+    }
+  }
+}
+
 }  // namespace STI2D
