+#pragma once
+
+#include <stdint.h>
+
+#include "library.h"
+
+namespace Sms {
+
+/* The conversation engine of the SMS app: it finds the topic of a message
+ * from its keywords, then picks a reply of the character, avoiding the ones
+ * said recently. It also answers calculations, the time and the date, and
+ * remembers the user's name. Texts stay compressed in flash: a block of the
+ * library is decompressed into the working buffer when a text is needed. */
+class Engine {
+ public:
+  constexpr static int k_textSize = 160;
+  struct Memory {
+    char userName[16];
+    uint16_t recent[10];  // Texts said recently, not to repeat them
+    uint8_t recentIndex;
+  };
+
+  Engine(char* blockBuffer) : m_blockBuffer(blockBuffer), m_blockInBuffer(-1) {}
+  void reply(int character, const char* message, Memory* memory, char* buffer);
+  void greeting(int character, Memory* memory, char* buffer);
+  int numberOfQuickReplies() const { return Library::k_quickReplies.count; }
+  void quickReply(int index, char* buffer);
+  static const Library::Character& character(int index) {
+    return Library::k_characters[index];
+  }
+
+ private:
+  const char* text(int id);
+  int pick(Library::Range range, Memory* memory);
+  void compose(int character, int textId, bool decorate, Memory* memory,
+               const char* result, char* buffer);
+  static int findTopic(const char* normalized);
+
+  char* m_blockBuffer;  // Library::k_blocks[i].size bytes, at most 4096
+  int m_blockInBuffer;
+};
+
+}  // namespace Sms
