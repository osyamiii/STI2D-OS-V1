--- /dev/null
+++ b/epsilon/apps/customize/controller.cpp
@@ -0,0 +1,146 @@
+#include "controller.h"
+
+#include <apps/i18n.h>
+#include <apps/sti2d/face.h>
+#include <apps/sti2d/style.h>
+#include <apps/sti2d/theme.h>
+
+using namespace STI2D;
+
+namespace Customize {
+
+Controller::Controller(Escher::Responder* parentResponder)
+    : ViewController(parentResponder), m_view(this), m_setting(Setting::Face) {}
+
+void Controller::viewWillAppear() {
+  ViewController::viewWillAppear();
+  m_setting = Setting::Face;
+  m_view.reload();
+}
+
+/* With a wallpaper, the first background is the wallpaper, then come the
+ * colors. */
+static int wallpaperShift() { return Style::hasWallpaper() ? 1 : 0; }
+
+int Controller::numberOfValues(Setting setting) const {
+  switch (setting) {
+    case Setting::Face:
+      return Style::k_numberOfFaces;
+    case Setting::Theme:
+      return Style::k_numberOfThemes;
+    case Setting::Accent:
+      return Style::k_numberOfAccents;
+    default:
+      return Style::k_numberOfBackgroundColors + wallpaperShift();
+  }
+}
+
+int Controller::value(Setting setting) const {
+  switch (setting) {
+    case Setting::Face:
+      return static_cast<int>(Style::face());
+    case Setting::Theme:
+      return static_cast<int>(Style::theme());
+    case Setting::Accent:
+      return Style::accentIndex();
+    default:
+      if (Style::background() == Style::Background::Wallpaper) {
+        return 0;
+      }
+      return Style::backgroundColorIndex() + wallpaperShift();
+  }
+}
+
+void Controller::setValue(Setting setting, int v) {
+  switch (setting) {
+    case Setting::Face:
+      Style::setFace(static_cast<Style::Face>(v));
+      return;
+    case Setting::Theme:
+      Style::setTheme(static_cast<Style::Theme>(v));
+      return;
+    case Setting::Accent:
+      Style::setAccentIndex(v);
+      return;
+    default:
+      if (v < wallpaperShift()) {
+        Style::setBackground(Style::Background::Wallpaper);
+      } else {
+        Style::setBackground(Style::Background::Color);
+        Style::setBackgroundColorIndex(v - wallpaperShift());
+      }
+  }
+}
+
+I18n::Message Controller::valueName(Setting setting, int v) const {
+  switch (setting) {
+    case Setting::Face:
+      return Style::faceName(static_cast<Style::Face>(v));
+    case Setting::Theme:
+      return Style::themeName(static_cast<Style::Theme>(v));
+    case Setting::Accent:
+      return Style::accentName(v);
+    default:
+      if (v < wallpaperShift()) {
+        return I18n::Message::BackgroundWallpaper;
+      }
+      return Style::backgroundColorName(v - wallpaperShift());
+  }
+}
+
+bool Controller::handleEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::Up || event == Ion::Events::Down) {
+    int s = static_cast<int>(m_setting) + (event == Ion::Events::Down ? 1 : -1);
+    m_setting = static_cast<Setting>((s + k_numberOfSettings) % k_numberOfSettings);
+  } else if (event == Ion::Events::Left || event == Ion::Events::Right ||
+             event == Ion::Events::OK || event == Ion::Events::EXE) {
+    int n = numberOfValues(m_setting);
+    int v = value(m_setting) + (event == Ion::Events::Left ? n - 1 : 1);
+    setValue(m_setting, v % n);
+  } else {
+    return false;
+  }
+  m_view.reload();
+  return true;
+}
+
+void Controller::PreviewView::drawRect(KDContext* ctx, KDRect rect) const {
+  KDColor buffer[Canvas::k_bufferSize];
+  Canvas canvas(rect.intersectedWith(bounds()), absoluteOrigin(), buffer);
+  while (canvas.nextBand()) {
+    drawScene(&canvas);
+  }
+}
+
+void Controller::PreviewView::drawScene(Canvas* canvas) const {
+  const Controller* c = m_controller;
+  drawWatchFace(canvas, currentFaceData(), 256, true);
+  // The setting being edited, in a card at the top, like on the watch
+  constexpr I18n::Message settings[] = {
+      I18n::Message::CustomizeFace, I18n::Message::CustomizeTheme,
+      I18n::Message::CustomizeAccent, I18n::Message::CustomizeBackground};
+  float width = bounds().width();
+  constexpr float top = 4, height = 46, margin = 40;
+  if (!canvas->intersects(top, top + height)) {
+    return;
+  }
+  canvas->fillRoundedRect(margin, top, width - 2 * margin, height, 16,
+                          KDColor::RGB24(0x1C1C1E), 230);
+  canvas->centeredText(I18n::translate(settings[static_cast<int>(c->m_setting)]),
+                       k_smallFont, width / 2, top + 5, k_secondaryText);
+  const char* name =
+      I18n::translate(c->valueName(c->m_setting, c->value(c->m_setting)));
+  canvas->centeredText(name, k_mediumFont, width / 2, top + 21,
+                       Style::accent());
+  // Arrows and the position of the setting
+  canvas->text("«", k_mediumFont, margin + 10, top + 21, KDWhite);
+  canvas->text("»", k_mediumFont, width - margin - 20, top + 21, KDWhite);
+  for (int i = 0; i < k_numberOfSettings; i++) {
+    canvas->fillCircle(width / 2 - 15 + 10 * i, top + height - 5, 2,
+                       i == static_cast<int>(c->m_setting)
+                           ? KDWhite
+                           : KDColor::RGB24(0x5A5A5E));
+  }
+}
+
+}  // namespace Customize
